---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/ruta';
import { sitio } from '../config/sitio';
import { cargarFotos } from '../lib/fotos';
import Visor from '../components/Visor.astro';
import Especialidades from '../components/Especialidades.astro';
import Trabajo from '../components/Trabajo.astro';
import Contacto from '../components/Contacto.astro';

const fotos = await cargarFotos();
const { ciudad } = sitio.contacto;
const titulo = `${sitio.nombre} · Fotógrafa en ${ciudad || 'España'} | Bodas, viajes y book`;
const descripcion = `Fotógrafa y modelo en ${ciudad}. Bodas en la playa, bautizos, comuniones, book de modelo, viajes y campañas para marcas, con más de diez años en el sector.`;

// Los dos lados de Clara: una foto suya y una en la que posa ella
const detras = fotos.find((f) => f.lado === 'detras' && f.seleccionada) ?? fotos.find((f) => f.lado === 'detras');
const delante = fotos.find((f) => f.lado === 'delante' && f.seleccionada) ?? fotos.find((f) => f.lado === 'delante');
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  ogFoto={fotos.find((f) => f.archivo === 'boda-beso-arco.jpg') ?? fotos[0]}
  hayTrabajo={fotos.length > 0}
>
  <Visor fotos={fotos} />
  <Especialidades fotos={fotos} />

  <section class="sobre" aria-labelledby="t-sobre">
    <div class="copias" aria-hidden="true">
      {detras && <figure class="copia uno"><img src={detras.mini} alt="" width={detras.ancho} height={detras.alto} loading="lazy" decoding="async" /><figcaption>Detrás</figcaption></figure>}
      {delante && <figure class="copia dos"><img src={delante.mini} alt="" width={delante.ancho} height={delante.alto} loading="lazy" decoding="async" /><figcaption>Delante</figcaption></figure>}
    </div>
    <div class="texto">
      <h2 class="titulo-seccion" id="t-sobre">Los dos lados de la cámara</h2>
      <p>{sitio.sobre[0]}</p>
      <ul class="enlaces">
        <li><a href={ruta('/sobre-clara/')}>Conoce a Clara</a></li>
        <li><a href={ruta('/portfolio/')}>Ver el portfolio completo</a></li>
        <li><a href={ruta('/modelo-para-marcas/')}>Clara como modelo</a></li>
      </ul>
    </div>
  </section>

  <Trabajo fotos={fotos} soloVisor />
  <Contacto />
</Base>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(3rem, 8vw, 7rem) var(--margen) clamp(5rem, 10vw, 8rem);
  }
  .copias { position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: start; max-width: 30rem; }
  .copia { margin: 0; background: #fbfbf8; padding: .55rem .55rem 2.2rem; box-shadow: 0 18px 36px -14px rgba(0, 0, 0, .4); position: relative; }
  .copia img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .copia figcaption { position: absolute; left: .7rem; bottom: .55rem; font: 500 .75rem/1 var(--borde); letter-spacing: .12em; text-transform: uppercase; color: var(--lapiz); }
  .uno { rotate: -5deg; }
  .dos { rotate: 4deg; margin-top: 2.5rem; margin-left: -1.5rem; }
  .texto p { max-width: 46ch; font-size: var(--t-1); line-height: 1.5; margin: 0 0 1.75rem; }
  .enlaces { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .enlaces a {
    font: 400 var(--t-2)/1.2 var(--serif);
    text-decoration: none;
    background: linear-gradient(var(--lapiz), var(--lapiz)) 0 100% / 0 2px no-repeat;
    transition: background-size .35s var(--ease);
  }
  .enlaces a::after { content: ' →'; color: var(--lapiz); }
  .enlaces a:hover, .enlaces a:focus-visible { background-size: 100% 2px; }
  @media (max-width: 900px) {
    .sobre { grid-template-columns: 1fr; }
    .copias { max-width: 22rem; }
  }
</style>
