---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/ruta';
import { sitio } from '../config/sitio';
import { cargarFotos, sinModelo, type Foto } from '../lib/fotos';
import Portada from '../components/Portada.astro';
import Especialidades from '../components/Especialidades.astro';
import Contacto from '../components/Contacto.astro';

const fotos = sinModelo(await cargarFotos());
const f = (a: string) => fotos.find((x) => x.archivo === a);
const { ciudad } = sitio.contacto;
const titulo = `${sitio.nombre} · Fotografía de bodas en ${ciudad || 'España'}`;
const descripcion = `Fotógrafa de bodas en ${ciudad}: bodas reales contadas con mirada de revista, de los preparativos a la fiesta. También bautizos, comuniones, book y marcas.`;

const intro = { grande: f('boda-novia-ventana.jpg'), pequena: f('boda-anillos-manos.jpg') };
const boda = f('boda-novios-risas.jpg');
const lados = { izq: f('boda-preparativos-puno-camisa.jpg'), centro: f('boda-novios-sentados-mar.jpg'), der: f('boda-cola-vestido-arena.jpg') };
const banda = [f('boda-novios-espaldas-mar.jpg'), f('viena-iglesia-san-pedro.jpg'), f('boda-novia-caricia.jpg')].filter((x): x is Foto => !!x);

const img = (foto: Foto | undefined, sizes: string) =>
  foto ? { src: foto.mini, srcset: foto.srcset, sizes, width: foto.ancho, height: foto.alto, alt: foto.alt } : null;
const iIntroG = img(intro.grande, '(max-width: 800px) 80vw, 34vw');
const iIntroP = img(intro.pequena, '(max-width: 800px) 45vw, 20vw');
const iBoda = img(boda, '(max-width: 900px) 100vw, 60vw');
const iIzq = img(lados.izq, '(max-width: 800px) 40vw, 18vw');
const iCentro = img(lados.centro, '(max-width: 800px) 90vw, 40vw');
const iDer = img(lados.der, '(max-width: 800px) 40vw, 16vw');
---

<Base titulo={titulo} descripcion={descripcion} ogFoto={f('boda-novios-corriendo-cesped.jpg') ?? fotos[0]} hayTrabajo={fotos.length > 0} menuSobreFoto>
  <Portada fotos={fotos} />

  <!-- Presentación -->
  <section class="intro" aria-labelledby="t-intro">
    {iIntroG && <img {...iIntroG} class="intro-grande revela" loading="lazy" decoding="async" />}
    <div class="intro-texto revela">
      <span class="antetitulo">Fotógrafa en {ciudad}</span>
      <h2 id="t-intro" class="intro-titulo">Fotografía natural con mirada de revista</h2>
      <p>
        Bodas, familias, viajes y marcas. Más de diez años en el sector: delante del objetivo como modelo y, desde
        hace cinco, detrás como fotógrafa. Por eso sabe cómo hacer que estés cómoda y salgas como eres.
      </p>
      <a class="enlace-linea" href={ruta('/sobre-clara/')}>Conoce a Clara</a>
    </div>
    {iIntroP && <img {...iIntroP} class="intro-pequena revela" loading="lazy" decoding="async" />}
  </section>

  <!-- Bodas -->
  <section class="bodas" aria-labelledby="t-bodas">
    {iBoda && <img {...iBoda} class="bodas-foto revela" loading="lazy" decoding="async" />}
    <div class="bodas-texto revela">
      <span class="antetitulo">Bodas</span>
      <h2 id="t-bodas" class="titulo-seccion">Vuestro día, contado entero</h2>
      <p>
        De los nervios de los preparativos al último abrazo. Clara trabaja con discreción en los momentos importantes y
        dirige con calma los retratos de pareja, porque sabe lo que se siente delante de la cámara.
      </p>
      <div class="acciones">
        <a class="enlace-linea" href={ruta('/bodas/#boda-real')}>Ver una boda real</a>
        <a class="enlace-solo" href={ruta('/bodas/#contacto')}>Consultar tu fecha</a>
      </div>
    </div>
  </section>

  <Especialidades fotos={fotos} />

  <!-- Los dos lados -->
  <section class="lados" aria-labelledby="t-lados">
    <h2 id="t-lados" class="lados-titulo revela"><span>Sin poses</span><span>forzadas</span></h2>
    {iIzq && <img {...iIzq} class="lados-izq revela" loading="lazy" decoding="async" />}
    {iCentro && <img {...iCentro} class="lados-centro revela" loading="lazy" decoding="async" />}
    {iDer && <img {...iDer} class="lados-der revela" loading="lazy" decoding="async" />}
    <div class="lados-texto revela">
      <p>
        Clara trabaja con discreción mientras pasan las cosas importantes y dirige con calma cuando toca hacer los
        retratos: dónde mirar, qué hacer con las manos y cómo colocaros para que la luz os favorezca.
      </p>
      <a class="enlace-linea" href={ruta('/sobre-clara/')}>Sobre Clara</a>
    </div>
  </section>

  <!-- Banda a sangre -->
  {banda.length === 3 && (
    <a class="banda" href={ruta('/portfolio/')}>
      {banda.map((b) => (
        <img src={b.mini} srcset={b.srcset} sizes="(max-width: 700px) 100vw, 34vw" alt={b.alt} width={b.ancho} height={b.alto} loading="lazy" decoding="async" />
      ))}
      <span class="banda-texto">
        <span class="banda-titulo">Portfolio</span>
        <span class="banda-sub">Ver todas las fotos</span>
      </span>
    </a>
  )}

  <Contacto />
</Base>

<style>
  /* ── Presentación ── */
  .intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: 0 clamp(2.5rem, 7vw, 8rem);
    padding: clamp(5rem, 11vw, 10rem) var(--margen) clamp(4rem, 8vw, 7rem);
    max-width: 110rem;
    margin: 0 auto;
  }
  .intro-grande { grid-column: 1; grid-row: 1 / span 2; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .intro-texto { grid-column: 2; grid-row: 1; align-self: end; max-width: 32rem; display: grid; justify-items: start; padding-bottom: clamp(2rem, 5vw, 4rem); }
  .intro-titulo { margin: 0 0 1.4rem; font: 300 clamp(1.8rem, 3vw, 2.9rem)/1.2 var(--serif); font-style: italic; }
  .intro-texto p { margin: 0 0 2rem; color: var(--grafito-suave); }
  /* La foto pequeña se monta sobre el borde de la grande */
  .intro-pequena {
    grid-column: 2; grid-row: 2;
    align-self: end;
    width: min(70%, 22rem);
    aspect-ratio: 4 / 5; object-fit: cover;
    margin-left: calc(-1 * clamp(5rem, 12vw, 13rem));
    margin-bottom: calc(-1 * clamp(2rem, 5vw, 4rem));
    outline: clamp(.5rem, 1vw, .9rem) solid var(--papel);
    position: relative;
  }

  /* ── Bodas ── */
  .bodas {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(3rem, 7vw, 6rem) var(--margen) clamp(3rem, 7vw, 6rem) 0;
  }
  .bodas-foto { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .bodas-texto p { margin: 0 0 2.2rem; color: var(--grafito-suave); max-width: 36ch; }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .enlace-solo {
    font: 500 .72rem/1 var(--sans); letter-spacing: .22em; text-transform: uppercase;
    color: inherit; text-decoration: none; padding-bottom: .45rem; border-bottom: 1px solid currentColor;
  }

  /* ── Delante y detrás ── */
  .lados {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(4rem, 9vw, 8rem) var(--margen);
    max-width: 110rem; margin: 0 auto;
  }
  .lados-titulo {
    grid-column: 1 / -1;
    margin: 0 0 clamp(1rem, 3vw, 2.5rem);
    display: grid; justify-items: center; gap: .1em;
    font: 300 clamp(2.4rem, 6.5vw, 6.5rem)/1.05 var(--serif);
    letter-spacing: .32em; text-transform: uppercase;
  }
  .lados-titulo span { margin-right: -.32em; }
  .lados-izq { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; margin-top: 2rem; }
  .lados-centro { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; margin-top: clamp(4rem, 9vw, 8rem); }
  .lados-der { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
  .lados-texto { grid-column: 2; text-align: center; display: grid; justify-items: center; }
  .lados-texto p { margin: 0 0 2rem; max-width: 46ch; color: var(--grafito-suave); }

  /* ── Banda a sangre ── */
  .banda { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); color: #fff; text-decoration: none; }
  .banda img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: filter .6s; }
  .banda:hover img { filter: brightness(.75); }
  .banda-texto {
    position: absolute; inset: 0;
    display: grid; place-content: center; justify-items: center; gap: 1rem;
    background: rgba(0, 0, 0, .18);
  }
  .banda-titulo { font: 300 clamp(2.2rem, 6vw, 6rem)/1 var(--serif); letter-spacing: .3em; margin-right: -.3em; text-transform: uppercase; }
  .banda-sub { font: 500 .72rem/1 var(--sans); letter-spacing: .26em; text-transform: uppercase; padding-bottom: .45rem; border-bottom: 1px solid #fff; }

  @media (max-width: 800px) {
    .intro { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .intro-texto { grid-column: 1 / -1; grid-row: 1; margin-bottom: 1rem; padding-bottom: 1.5rem; }
    .intro-grande { grid-column: 1 / span 2; grid-row: 2; width: 82%; }
    .intro-pequena { grid-column: 2; grid-row: 2; justify-self: end; width: 62%; margin: 0 0 -2.5rem; }

    .bodas { grid-template-columns: 1fr; padding: 2rem 0 4rem; }
    .bodas-texto { padding: 0 var(--margen); }

    .lados { grid-template-columns: 1fr 1fr; }
    .lados-centro { grid-column: 1 / -1; grid-row: 3; margin-top: 0; }
    .lados-izq { grid-row: 2; margin-top: 3rem; }
    .lados-der { grid-row: 2; }
    .lados-texto { grid-column: 1 / -1; }

    .banda { grid-template-columns: 1fr 1fr; }
    .banda img:nth-child(3) { display: none; }
    .banda-titulo { font-size: clamp(1.8rem, 9vw, 3rem); letter-spacing: .2em; margin-right: -.2em; }
  }
</style>
