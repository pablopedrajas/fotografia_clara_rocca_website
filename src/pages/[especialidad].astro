---
import { ruta } from '../lib/ruta';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Trabajo from '../components/Trabajo.astro';
import BodaReal from '../components/BodaReal.astro';
import Contacto from '../components/Contacto.astro';
import { sitio } from '../config/sitio';
import { especialidades, type Especialidad } from '../config/especialidades';
import { cargarFotos } from '../lib/fotos';
import { idNegocio } from '../lib/negocio';

export function getStaticPaths() {
  return especialidades.map((e) => ({ params: { especialidad: e.slug }, props: { e } }));
}

const { e } = Astro.props as { e: Especialidad };
const todas = await cargarFotos();
// Primero las fotos de la categoría principal de la especialidad
const fotos = todas
  .filter((f) => e.categorias.includes(f.categoria))
  .sort((a, b) => e.categorias.indexOf(a.categoria) - e.categorias.indexOf(b.categoria));
const ciudad = sitio.contacto.ciudad;

const h1 = ciudad ? `${e.busqueda} en ${ciudad}` : e.busqueda;
const titulo = `${h1} · ${sitio.nombre}`;
const descripcion = ciudad ? `${e.descripcion} En ${ciudad}.` : e.descripcion;
const otras = especialidades.filter((o) => o.slug !== e.slug);
// Dos copias para la cabecera: la portada de la especialidad y otra vertical distinta
const primeraCab = fotos.find((f) => f.archivo === e.portada) ?? fotos.find((f) => f.vertical) ?? fotos[0];
const fotosCabecera = [primeraCab, fotos.filter((f) => f !== primeraCab && f.vertical).at(Math.floor(fotos.length / 3)) ?? fotos.find((f) => f !== primeraCab)];
const urlPagina = sitio.url ? new URL(`/${e.slug}/`, sitio.url).href : undefined;

const jsonld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    serviceType: e.busqueda,
    description: descripcion,
    provider: { '@id': idNegocio },
    ...(sitio.url && fotos.length > 0 && { image: fotos.slice(0, 8).map((f) => new URL(f.grande, sitio.url).href) }),
    ...(ciudad && { areaServed: { '@type': 'City', name: ciudad } }),
    ...(urlPagina && { url: urlPagina }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: e.preguntas.map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
    })),
  },
];
if (sitio.url) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: sitio.nombre, item: new URL('/', sitio.url).href },
      { '@type': 'ListItem', position: 2, name: e.nombre, item: urlPagina },
    ],
  });
}
---

<Base titulo={titulo} descripcion={descripcion} ogFoto={fotos.find((f) => f.archivo === e.portada) ?? fotos.find((f) => f.seleccionada) ?? fotos[0]} jsonld={jsonld} hayTrabajo={todas.length > 0}>
  <Cabecera titulo={h1} actual={e.nombre} entradilla={e.entradilla} fotos={fotosCabecera} />

  <section class="cuerpo" id="como-trabaja" aria-label={`Cómo trabaja Clara en ${e.nombre.toLowerCase()}`}>
    <div class="parrafos">
      {e.parrafos.map((p) => <p>{p}</p>)}
    </div>
    <div class="pasos">
      <h2>Cómo es el encargo</h2>
      <ol>
        {e.pasos.map((p) => (
          <li>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {e.slug === 'bodas' && fotos.some((f) => f.fotograma) ? (
    <>
      <BodaReal fotos={fotos} />
      <Trabajo fotos={fotos} soloVisor />
    </>
  ) : (
    <Trabajo fotos={fotos} titulo={e.nombre} />
  )}

  <section class="preguntas" id="preguntas" aria-labelledby="t-preguntas">
    <h2 class="titulo-seccion" id="t-preguntas">Preguntas frecuentes</h2>
    <div class="lista">
      {e.preguntas.map((p, i) => (
        <details open={i === 0}>
          <summary>{p.pregunta}</summary>
          <p>{p.respuesta}</p>
        </details>
      ))}
    </div>
  </section>

  <nav class="otras" aria-label="Otras especialidades">
    <h2>También fotografía</h2>
    <ul>
      {otras.map((o) => <li><a href={ruta(`/${o.slug}/`)}>{o.nombre}</a></li>)}
    </ul>
  </nav>

  <Contacto tipo={e.nombre} />
</Base>

<style>
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    padding: clamp(4rem, 8vw, 7rem) var(--margen) clamp(5rem, 10vw, 8rem);
    max-width: 110rem;
    margin: 0 auto;
  }
  .parrafos p { max-width: 56ch; margin: 0 0 1.2em; line-height: 1.7; font-size: clamp(1.2rem, 1.4vw, 1.35rem); }
  .parrafos p:first-child::first-letter {
    float: left; font: 300 4.6em/.8 var(--serif); padding: .08em .12em 0 0;
  }
  .pasos h2 {
    font: 500 .72rem/1.4 var(--sans); letter-spacing: .24em; text-transform: uppercase;
    color: var(--grafito-suave); margin: .4rem 0 2rem;
  }
  .pasos ol { list-style: none; margin: 0; padding: 0; counter-reset: paso; display: grid; gap: 0; }
  .pasos li {
    counter-increment: paso;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: .75rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--linea);
  }
  .pasos li::before {
    content: counter(paso, upper-roman);
    grid-row: span 2;
    font: 300 1.5rem/1.1 var(--serif);
    letter-spacing: .1em;
  }
  .pasos h3 { margin: 0 0 .3rem; font: 400 1.3rem/1.25 var(--serif); text-transform: uppercase; letter-spacing: .1em; }
  .pasos li p { margin: 0; color: var(--grafito-suave); line-height: 1.55; }

  .preguntas { padding: clamp(2rem, 5vw, 4rem) var(--margen) clamp(4rem, 9vw, 7rem); display: grid; justify-items: center; }
  .preguntas .titulo-seccion { text-align: center; }
  .lista { width: min(100%, 52rem); }
  details { border-top: 1px solid var(--linea); }
  details:last-child { border-bottom: 1px solid var(--linea); }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 0;
    font: 400 clamp(1.25rem, 1.8vw, 1.5rem)/1.3 var(--serif);
    overflow-wrap: break-word;
  }
  .lista, details { min-width: 0; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; width: 1em; margin-right: .2em; text-align: center; font: 300 1.6rem/1 var(--serif); transition: rotate .3s var(--ease); }
  details[open] summary::after { rotate: 45deg; }
  details p { margin: 0 0 1.5rem; max-width: 60ch; color: var(--grafito-suave); line-height: 1.65; }

  .otras { padding: 0 var(--margen) clamp(4rem, 9vw, 7rem); text-align: center; }
  .otras h2 { font: 500 .72rem/1.4 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--grafito-suave); margin: 0 0 1.5rem; }
  .otras ul { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 2.5rem; list-style: none; margin: 0; padding: 0; }
  .otras a {
    font: 300 clamp(1.3rem, 2vw, 1.8rem)/1.2 var(--serif);
    text-transform: uppercase; letter-spacing: .12em;
    text-decoration: none;
    border-bottom: 1px solid transparent; transition: border-color .3s;
  }
  .otras a:hover, .otras a:focus-visible { border-bottom-color: currentColor; font-style: italic; }

  @media (max-width: 900px) {
    .cuerpo { grid-template-columns: 1fr; }
  }
</style>
