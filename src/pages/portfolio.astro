---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Trabajo from '../components/Trabajo.astro';
import Contacto from '../components/Contacto.astro';
import { sitio } from '../config/sitio';
import { cargarFotos } from '../lib/fotos';
import { migas, pagina } from '../lib/negocio';

const fotos = await cargarFotos();
const { ciudad } = sitio.contacto;
const titulo = `Portfolio de fotografía · ${sitio.nombre}, fotógrafa en ${ciudad}`;
const descripcion = `Portfolio de ${sitio.nombre}: bodas, viajes, paisaje, arquitectura, retrato, gastronomía y campañas de moda. Fotógrafa y modelo en ${ciudad}.`;
const jsonld = [
  pagina('CollectionPage', `Portfolio de ${sitio.nombre}`, '/portfolio/', {
    ...(sitio.url && { image: fotos.slice(0, 12).map((f) => new URL(f.grande, sitio.url).href) }),
  }),
  migas('Portfolio', '/portfolio/'),
].filter((d) => d !== null);
---

<Base titulo={titulo} descripcion={descripcion} ogFoto={fotos.find((f) => f.archivo === 'boda-novios-risas.jpg')} jsonld={jsonld} hayTrabajo>
  <Cabecera
    titulo="Portfolio de fotografía"
    actual="Portfolio"
    entradilla="Todo el trabajo de Clara en un mismo sitio. Filtra por tipo de sesión y toca cualquier foto para verla a pantalla completa."
    fotos={[fotos.find((f) => f.archivo === 'boda-novios-rocas.jpg'), fotos.find((f) => f.archivo === 'cala-aguas-turquesas.jpg')]}
  />
  <Trabajo fotos={fotos} titulo="Todas las fotos" tituloOculto inmediatas={6} />
  <Contacto />
</Base>
