---
/**
 * Portada: el visor de la cámara de Clara.
 * La imagen en directo va pasando sola; quien entra pulsa el disparador
 * (o toca la foto) y esa toma «se revela» en la mesa, junto al nombre.
 * Las fotos reveladas se pueden ampliar y enviar a Clara al pedir presupuesto.
 */
import { ruta } from '../lib/ruta';
import type { Foto } from '../lib/fotos';
import { sitio } from '../config/sitio';
import { especialidades } from '../config/especialidades';

interface Props { fotos: Foto[] }
const { fotos } = Astro.props;

const porNombre = (a: string) => fotos.find((f) => f.archivo === a);
const ORDEN = [
  'boda-beso-arco.jpg',
  'modelo-campana-moda-cuclillas.jpg',
  'cala-aguas-turquesas.jpg',
  'boda-novia-emocionada.jpg',
  'reportaje-artesana-fieltro.jpg',
  'modelo-campana-moda-raqueta.jpg',
  'boda-novios-rocas.jpg',
  'londres-noria-farolas.jpg',
  'boda-primer-beso.jpg',
  'globo-cielo-azul.jpg',
  'modelo-campana-moda-abrazo.jpg',
  'boda-recien-casados.jpg',
];
let tomas = ORDEN.map(porNombre).filter((f): f is Foto => !!f);
if (tomas.length < 3) tomas = fotos.filter((f) => f.vertical).slice(0, 12);

// Copias que ya están sobre la mesa al llegar
const enMesa = ['boda-novios-risas.jpg', 'salzburgo-vista-rio-salzach.jpg', 'modelo-campana-moda-sentada.jpg']
  .map(porNombre)
  .filter((f): f is Foto => !!f);

const destino = (f: Foto) => {
  const e = especialidades.find((x) => x.categorias.includes(f.categoria));
  return e ? { href: ruta(`/${e.slug}/`), nombre: e.nombre } : { href: ruta('/portfolio/'), nombre: 'Portfolio' };
};
const datos = tomas.map((f) => {
  const d = destino(f);
  return {
    id: f.id,
    alt: f.alt,
    src: f.grande,
    srcset: f.srcset,
    micro: f.micro,
    ancho: f.ancho,
    alto: f.alto,
    etiqueta: f.lado === 'delante' ? 'Clara, como modelo' : d.nombre,
    href: d.href,
  };
});
const primera = tomas[0];
const ciudad = sitio.contacto.ciudad;
const hayEmail = !!sitio.contacto.email;
const giro = [-7, 4, -2];
---

<section class="portada" aria-labelledby="t-portada" data-portada>
  <h1 id="t-portada" class="titulo">
    <span class="nombre"><span>Clara</span> <span class="segunda">Rocca</span></span>
    <span class="oficio">Fotógrafa y modelo{ciudad && ` en ${ciudad}`}</span>
  </h1>

  {primera && (
    <figure class="visor" aria-label="Visor de la cámara">
      <div class="pantalla" data-pantalla>
        <img
          class="toma"
          src={primera.grande}
          srcset={primera.srcset}
          sizes="(max-width: 900px) 92vw, 36vw"
          alt={primera.alt}
          width={primera.ancho}
          height={primera.alto}
          fetchpriority="high"
          decoding="async"
          data-toma
        />
        <span class="tercios" aria-hidden="true"></span>
        <span class="esq a" aria-hidden="true"></span><span class="esq b" aria-hidden="true"></span>
        <span class="esq c" aria-hidden="true"></span><span class="esq d" aria-hidden="true"></span>
        <span class="enfoque" aria-hidden="true" data-enfoque></span>
        <span class="iris" aria-hidden="true"></span>
        <span class="flash" aria-hidden="true"></span>
        <span class="hud arriba" aria-hidden="true"><span><i class="punto"></i>AF-S</span><span class="pila"><i></i></span></span>
        <span class="hud abajo">
          <span aria-hidden="true" data-cuenta-toma>01 / {String(datos.length).padStart(2, '0')}</span>
          <a href={datos[0].href} data-ir>{datos[0].etiqueta}</a>
        </span>
      </div>
      <a class="ultima" href="#mesa" data-ultima hidden aria-label="Ver tus fotos reveladas">
        <img alt="" data-ultima-img />
        <span data-ultima-n></span>
      </a>
      <button class="disparador" type="button" data-disparar>
        <span class="oculto">Disparar: revelar esta foto y pasar a la siguiente</span>
      </button>
      <figcaption class="oculto" data-pie>{primera.alt}</figcaption>
    </figure>
  )}

  <div class="cuerpo">
    <div class="intro">
      <p class="lema">
        Bodas, bautizos, comuniones, books, viajes y campañas para marcas. Más de diez años delante y detrás de la cámara.
      </p>
      <div class="acciones">
        <a class="boton" href={ruta('/bodas/')}>Ver bodas</a>
        {hayEmail && <a class="boton claro" href={ruta('/contacto/')}>Reservar sesión</a>}
      </div>
    </div>

    <div class="mesa" id="mesa">
      <p class="pista" data-pista>
        <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" /><circle cx="20" cy="20" r="9" /></svg>
        <span>Pulsa el disparador. Cada foto que hagas se revela aquí.</span>
      </p>
      <ul class="copias" data-copias>
        {enMesa.map((f, i) => (
          <li class="copia" style={`--giro:${giro[i % giro.length]}deg`}>
            <button type="button" data-abrir={f.id} aria-label={`Ampliar: ${f.alt}`}>
              <img src={f.micro} alt="" width={f.ancho} height={f.alto} loading="lazy" decoding="async" />
            </button>
          </li>
        ))}
      </ul>
      <div class="pedir" data-pedir hidden>
        <span data-pedir-cuenta></span>
        {hayEmail && <a href={ruta('/contacto/')} data-pedir-ir>Pedir presupuesto con estas fotos</a>}
        <button type="button" data-vaciar aria-label="Quitar las fotos reveladas">×</button>
      </div>
      <p class="oculto" aria-live="polite" data-aviso></p>
    </div>
  </div>

  <script type="application/json" data-tomas set:html={JSON.stringify(datos)} />
</section>

<style>
  @property --abertura {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 100%;
  }

  .portada {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: 'titulo visor' 'cuerpo visor';
    column-gap: clamp(2rem, 5vw, 5rem);
    padding: calc(4.75rem + clamp(1rem, 3vw, 2.5rem)) var(--margen) clamp(2.5rem, 5vw, 4rem);
    min-height: 100svh;
  }

  /* — Nombre — */
  .titulo { grid-area: titulo; margin: 0; align-self: end; }
  .nombre {
    display: block;
    font: 400 clamp(4.5rem, min(11.5vw, 25svh), 16rem)/0.84 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.045em;
  }
  .nombre > span { display: block; }
  .segunda { padding-left: .6em; }
  .oficio {
    display: inline-block;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font: 600 clamp(1rem, 1.6vw, 1.25rem)/1.3 var(--sans);
    position: relative;
  }
  /* Subrayado de lápiz graso */
  .oficio::after {
    content: '';
    position: absolute; left: -2%; right: -2%; bottom: -.35rem; height: 4px;
    background: var(--lapiz); border-radius: 3px; rotate: -1deg;
    filter: url(#cera);
  }

  .cuerpo { grid-area: cuerpo; display: grid; align-content: start; gap: 1.5rem; padding-top: clamp(1.25rem, 2.5vw, 2rem); }
  .intro { display: grid; gap: 1.5rem; align-content: start; }
  .lema { margin: 0; max-width: 40ch; font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.5; color: var(--grafito-suave); }
  .acciones { display: flex; flex-wrap: wrap; gap: .75rem; }
  .boton {
    background: var(--pelicula); color: var(--papel);
    padding: .85rem 1.4rem; font-weight: 600; text-decoration: none;
    transition: background .2s;
  }
  .boton:hover { background: var(--lapiz); }
  .boton.claro { background: transparent; color: var(--grafito); box-shadow: inset 0 0 0 1.5px var(--grafito); }
  .boton.claro:hover { background: var(--grafito); color: var(--papel); }

  /* — Visor — */
  .visor {
    grid-area: visor;
    margin: 0;
    align-self: start;
    justify-self: end;
    position: relative;
    margin-top: .55rem;
    width: min(100%, calc((100svh - 13rem) * 2 / 3));
    padding-bottom: 2.4rem;
  }
  .pantalla {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--pelicula);
    cursor: crosshair;
    border-radius: 3px;
    box-shadow: 0 0 0 .55rem var(--pelicula), 0 30px 60px -20px rgba(0, 0, 0, .55);
  }
  .pantalla :global(.toma) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    animation: directo 7s linear both;
  }
  .pantalla :global(.toma.entra) { animation: aparece .7s var(--ease) both, directo 7s linear both; }
  @keyframes directo { from { scale: 1.06; } to { scale: 1; } }
  @keyframes aparece { from { opacity: 0; } }

  .tercios {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(33.33% - .5px), rgba(255, 255, 255, .28) calc(33.33% - .5px) calc(33.33% + .5px), transparent 0, transparent calc(66.66% - .5px), rgba(255, 255, 255, .28) calc(66.66% - .5px) calc(66.66% + .5px), transparent 0),
      linear-gradient(transparent calc(33.33% - .5px), rgba(255, 255, 255, .28) calc(33.33% - .5px) calc(33.33% + .5px), transparent 0, transparent calc(66.66% - .5px), rgba(255, 255, 255, .28) calc(66.66% - .5px) calc(66.66% + .5px), transparent 0);
  }
  .esq { position: absolute; width: 1.6rem; height: 1.6rem; border: 2px solid rgba(255, 255, 255, .9); pointer-events: none; }
  .esq.a { top: 1rem; left: 1rem; border-right: 0; border-bottom: 0; }
  .esq.b { top: 1rem; right: 1rem; border-left: 0; border-bottom: 0; }
  .esq.c { bottom: 1rem; left: 1rem; border-right: 0; border-top: 0; }
  .esq.d { bottom: 1rem; right: 1rem; border-left: 0; border-top: 0; }

  .enfoque {
    position: absolute;
    left: var(--fx, 50%); top: var(--fy, 45%);
    width: 4.5rem; height: 4.5rem;
    translate: -50% -50%;
    pointer-events: none;
    transition: left .35s var(--ease), top .35s var(--ease), scale .25s var(--ease);
    background:
      linear-gradient(currentColor, currentColor) 0 0 / .9rem 2px no-repeat,
      linear-gradient(currentColor, currentColor) 0 0 / 2px .9rem no-repeat,
      linear-gradient(currentColor, currentColor) 100% 0 / .9rem 2px no-repeat,
      linear-gradient(currentColor, currentColor) 100% 0 / 2px .9rem no-repeat,
      linear-gradient(currentColor, currentColor) 0 100% / .9rem 2px no-repeat,
      linear-gradient(currentColor, currentColor) 0 100% / 2px .9rem no-repeat,
      linear-gradient(currentColor, currentColor) 100% 100% / .9rem 2px no-repeat,
      linear-gradient(currentColor, currentColor) 100% 100% / 2px .9rem no-repeat;
    color: rgba(255, 255, 255, .95);
  }
  .portada.enfocando .enfoque { color: var(--ambar); scale: .78; }

  .hud {
    position: absolute; left: 2.9rem; right: 2.9rem;
    display: flex; justify-content: space-between; align-items: center;
    font: 500 1rem/1 var(--borde);
    letter-spacing: .08em;
    color: #ffd06a;
    text-shadow: 0 0 6px rgba(255, 200, 90, .55);
    pointer-events: none;
  }
  .hud > span { background: rgba(0, 0, 0, .5); padding: .4rem .55rem; display: inline-flex; align-items: center; }
  .hud .pila { background: none; }
  .hud.arriba { top: 1.15rem; }
  .hud.abajo { bottom: 1.15rem; }
  .punto { display: inline-block; width: .5rem; height: .5rem; margin-right: .45rem; border-radius: 50%; background: #5bd36b; }
  .pila { display: inline-block; width: 1.6rem; height: .75rem; border: 1.5px solid currentColor; border-radius: 2px; padding: 1.5px; position: relative; }
  .pila::after { content: ''; position: absolute; right: -4px; top: 25%; height: 50%; width: 2px; background: currentColor; }
  .pila i { display: block; height: 100%; width: 75%; background: currentColor; }
  .hud a {
    pointer-events: auto;
    color: var(--papel); text-decoration: none;
    background: rgba(0, 0, 0, .45);
    padding: .45rem .65rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-size: .72rem;
  }
  .hud a::after { content: ' →'; }
  .hud a:hover { background: var(--lapiz); }

  /* Obturador: el diafragma se cierra y se vuelve a abrir */
  .iris {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle, transparent var(--abertura), #000 calc(var(--abertura) + 1%));
    --abertura: 100%;
  }
  .flash { position: absolute; inset: 0; pointer-events: none; background: #fff; opacity: 0; }
  .portada.dispara .iris { animation: obturar .34s cubic-bezier(.6, 0, .4, 1); }
  .portada.dispara .flash { animation: destello .45s .12s ease-out; }
  @keyframes obturar { 0% { --abertura: 100%; } 45%, 55% { --abertura: 0%; } 100% { --abertura: 100%; } }
  @keyframes destello { 0% { opacity: .75; } 100% { opacity: 0; } }

  .disparador {
    position: absolute;
    left: 50%; bottom: 0;
    translate: -50% 0;
    width: 4.6rem; height: 4.6rem;
    border-radius: 50%;
    border: 0;
    background: var(--papel);
    box-shadow: 0 0 0 .3rem var(--pelicula), 0 10px 24px rgba(0, 0, 0, .35);
    cursor: pointer;
    display: grid; place-items: center;
  }
  .disparador::before {
    content: '';
    width: 70%; height: 70%;
    border-radius: 50%;
    background: var(--lapiz);
    box-shadow: inset 0 -4px 0 rgba(0, 0, 0, .18);
    transition: scale .12s, background .2s;
  }
  .disparador:hover::before { background: #e0473e; }
  .disparador:active::before, .portada.dispara .disparador::before { scale: .86; }
  .disparador:focus-visible { outline: 3px solid var(--ambar); outline-offset: 5px; }

  /* — Mesa de revelado — */
  .mesa { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 1rem; margin-top: clamp(.5rem, 2vw, 1.5rem); }
  .pista { display: flex; align-items: center; gap: .6rem; margin: 0; font-size: .9375rem; color: var(--grafito-suave); }
  .pista svg { width: 1.6rem; height: 1.6rem; flex: none; fill: none; stroke: var(--lapiz); stroke-width: 2.5; }
  .copias {
    list-style: none; margin: 0; padding: .5rem 0 .5rem .9rem;
    display: flex; align-items: flex-start;
    min-height: 9.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .copias::-webkit-scrollbar { display: none; }
  .copias :global(.copia) { flex: none; margin-left: -.9rem; rotate: var(--giro, 0deg); translate: var(--dx, 0) 0; transition: rotate .3s var(--ease), translate .3s var(--ease); }
  .copias :global(.copia:hover), .copias :global(.copia:focus-within) { rotate: 0deg; translate: var(--dx, 0) -.4rem; z-index: 50 !important; }
  .copias :global(.copia button) {
    display: block; border: 0; cursor: zoom-in;
    background: #fbfbf8;
    padding: .4rem .4rem 1.5rem;
    box-shadow: 0 10px 22px -8px rgba(0, 0, 0, .4), 0 0 0 1px rgba(0, 0, 0, .05);
  }
  .copias :global(.copia img) { display: block; height: 7rem; width: auto; max-width: 9rem; object-fit: cover; }
  .copias :global(.copia.nueva) { animation: cae .6s var(--ease) both; }
  .copias :global(.copia.nueva img) { animation: revela 2.6s ease-out both; }
  @keyframes cae { from { translate: 0 -3rem; scale: 1.25; opacity: 0; } }
  /* Como en el cuarto oscuro: de la luz roja y el papel en blanco a la foto */
  @keyframes revela {
    0% { filter: sepia(1) hue-rotate(-35deg) saturate(3) brightness(.25) contrast(.6); opacity: .4; }
    60% { filter: sepia(.6) hue-rotate(-20deg) saturate(1.6) brightness(.8); opacity: 1; }
    100% { filter: none; }
  }

  .pedir {
    display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: .6rem 1rem;
    font: 500 .8rem/1.2 var(--borde); letter-spacing: .06em;
  }
  .pedir[hidden] { display: none; }
  .pedir a {
    font: 600 .9375rem/1 var(--sans); letter-spacing: 0;
    background: var(--lapiz); color: #fff; text-decoration: none; padding: .7rem 1rem;
  }
  .pedir a:hover { background: var(--pelicula); }
  .pedir a { grid-row: 2; grid-column: 1 / -1; justify-self: start; }
  .pedir button { background: none; border: 0; font-size: 1.3rem; line-height: 1; cursor: pointer; color: var(--grafito-suave); padding: .2rem .4rem; }

  /* Pantallas anchas: la mesa de revelado ocupa la columna central, junto a la cámara */
  @media (min-width: 1280px) {
    .portada {
      grid-template-columns: minmax(0, 1fr) clamp(14rem, 18vw, 22rem) auto;
      grid-template-areas: 'titulo mesa visor' 'cuerpo mesa visor';
      align-items: start;
    }
    .cuerpo { display: contents; }
    .intro { grid-area: cuerpo; padding-top: clamp(1.25rem, 2.5vw, 2rem); }
    .visor { width: min(34vw, calc((100svh - 11rem) * 2 / 3)); }
    .mesa {
      grid-area: mesa;
      align-self: stretch;
      margin: .55rem 0 0;
      display: flex; flex-direction: column;
      min-height: 0;
      max-height: calc((min(34vw, calc((100svh - 11rem) * 2 / 3))) * 3 / 2 + 2.4rem);
    }
    .pista { align-items: flex-start; }
    .copias {
      flex: 1;
      flex-direction: column;
      align-items: center;
      overflow-x: visible;
      overflow-y: auto;
      padding: 1.25rem .75rem 1.5rem;
      min-height: 0;
    }
    .copias :global(.copia) { margin: calc(clamp(9rem, 11.5vw, 15rem) * -.95) 0 0; }
    .copias :global(.copia:first-child) { margin-top: 0; }
    .copias :global(.copia:nth-child(odd)) { --dx: 1.1rem; }
    .copias :global(.copia:nth-child(even)) { --dx: -1.1rem; }
    .copias :global(.copia img) { width: clamp(9rem, 11.5vw, 15rem); height: auto; aspect-ratio: 4 / 5; max-width: none; }
  }

  /* Miniatura de la última foto, como en la cámara del móvil */
  .ultima {
    position: absolute; left: .4rem; bottom: .2rem;
    width: 3.4rem; height: 3.4rem;
    border: 3px solid #fbfbf8; background: #fbfbf8;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .35);
    rotate: -6deg;
    display: none;
  }
  .ultima img { width: 100%; height: 100%; object-fit: cover; }
  .ultima span {
    position: absolute; right: -.6rem; top: -.6rem;
    min-width: 1.4rem; height: 1.4rem; padding: 0 .3rem;
    border-radius: 1rem; background: var(--lapiz); color: #fff;
    font: 700 .75rem/1.4rem var(--sans); text-align: center;
  }
  .ultima.salta { animation: salta .5s var(--ease); }
  @keyframes salta { 0% { scale: .4; } 60% { scale: 1.12; } }

  @media (max-width: 900px) {
    .ultima:not([hidden]) { display: block; }
    .portada {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas: 'titulo' 'visor' 'cuerpo';
      padding-top: calc(4.5rem + 1.25rem);
      min-height: 0;
    }
    .nombre { font-size: clamp(3.6rem, 20vw, 9rem); }
    .oficio { margin-top: .8rem; }
    .visor { justify-self: stretch; width: auto; margin: 1.25rem .55rem 0; }
    .pantalla { aspect-ratio: 4 / 5; max-height: 60svh; width: 100%; }
    .cuerpo { display: flex; flex-direction: column; }
    .mesa { order: -1; margin-top: 0; }
    .copia img, .copias :global(.copia img) { height: 5.5rem; }
    .copias { min-height: 7.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pantalla :global(.toma), .pantalla :global(.toma.entra), .copias :global(.copia.nueva), .copias :global(.copia.nueva img) { animation: none; }
    .portada.dispara .iris { animation: none; }
  }
</style>

<script>
  interface Toma { id: string; alt: string; src: string; srcset: string; micro: string; ancho: number; alto: number; etiqueta: string; href: string }

  const portada = document.querySelector<HTMLElement>('[data-portada]');
  const pantalla = portada?.querySelector<HTMLElement>('[data-pantalla]');
  if (portada && pantalla) {
    const tomas: Toma[] = JSON.parse(portada.querySelector('[data-tomas]')!.textContent || '[]');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fino = matchMedia('(hover: hover) and (pointer: fine)');
    const copias = portada.querySelector<HTMLUListElement>('[data-copias]')!;
    const pedir = portada.querySelector<HTMLElement>('[data-pedir]')!;
    const cuentaPedir = portada.querySelector<HTMLElement>('[data-pedir-cuenta]')!;
    const aviso = portada.querySelector<HTMLElement>('[data-aviso]')!;
    const pie = portada.querySelector<HTMLElement>('[data-pie]')!;
    const ir = portada.querySelector<HTMLAnchorElement>('[data-ir]')!;
    const cuentaToma = portada.querySelector<HTMLElement>('[data-cuenta-toma]')!;
    const enfoque = portada.querySelector<HTMLElement>('[data-enfoque]')!;
    const total = String(tomas.length).padStart(2, '0');

    let i = 0;
    let ocupado = false;
    let reloj = 0;
    let visible = true;
    const elegidas: Toma[] = [];
    let capa = 10;
    const ultima = portada.querySelector<HTMLAnchorElement>('[data-ultima]')!;
    const ultimaImg = portada.querySelector<HTMLImageElement>('[data-ultima-img]')!;
    const ultimaN = portada.querySelector<HTMLElement>('[data-ultima-n]')!;

    const precargar = (t: Toma) => {
      const img = new Image();
      img.sizes = innerWidth <= 900 ? '92vw' : '36vw';
      img.srcset = t.srcset;
      img.src = t.src;
    };

    const mostrar = (n: number) => {
      i = (n + tomas.length) % tomas.length;
      const t = tomas[i];
      const nueva = document.createElement('img');
      nueva.className = 'toma entra';
      nueva.alt = t.alt;
      nueva.sizes = innerWidth <= 900 ? '92vw' : '36vw';
      nueva.srcset = t.srcset;
      nueva.src = t.src;
      nueva.decoding = 'async';
      const viejas = [...pantalla.querySelectorAll<HTMLImageElement>('[data-toma]')];
      nueva.setAttribute('data-toma', '');
      const colocar = () => {
        viejas.at(-1)!.after(nueva);
        setTimeout(() => viejas.forEach((v) => v.remove()), 800);
      };
      nueva.decode().then(colocar, colocar);
      pie.textContent = t.alt;
      ir.href = t.href;
      ir.textContent = t.etiqueta;
      cuentaToma.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
      precargar(tomas[(i + 1) % tomas.length]);
    };

    const programar = () => {
      clearTimeout(reloj);
      if (quieto || !visible || document.hidden) return;
      reloj = window.setTimeout(() => { mostrar(i + 1); programar(); }, 5200);
    };

    const nombreCuenta = (n: number) => (n === 1 ? '1 foto revelada' : `${n} fotos reveladas`);

    const revelar = (t: Toma) => {
      const li = document.createElement('li');
      li.className = 'copia nueva';
      li.style.zIndex = String(++capa);
      li.style.setProperty('--giro', `${(Math.random() * 14 - 7).toFixed(1)}deg`);
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.abrir = t.id;
      b.setAttribute('aria-label', `Ampliar: ${t.alt}`);
      const img = document.createElement('img');
      img.src = t.micro;
      img.alt = '';
      img.width = t.ancho;
      img.height = t.alto;
      b.append(img);
      li.append(b);
      copias.prepend(li);
      copias.scrollTo({ left: 0, behavior: quieto ? 'auto' : 'smooth' });
      // Como mucho diez copias en la mesa
      [...copias.children].slice(10).forEach((c) => c.remove());

      if (!elegidas.some((e) => e.id === t.id)) elegidas.push(t);
      cuentaPedir.textContent = nombreCuenta(elegidas.length);
      pedir.hidden = false;
      aviso.textContent = `Foto revelada: ${t.alt}`;
      ultimaImg.src = t.micro;
      ultimaN.textContent = String(elegidas.length);
      ultima.hidden = false;
      ultima.classList.remove('salta');
      void ultima.offsetWidth;
      ultima.classList.add('salta');
    };

    const disparar = () => {
      if (ocupado || !tomas.length) return;
      ocupado = true;
      clearTimeout(reloj);
      const t = tomas[i];
      portada.classList.add('enfocando');
      setTimeout(() => {
        portada.classList.remove('enfocando');
        portada.classList.add('dispara');
        setTimeout(() => {
          revelar(t);
          mostrar(i + 1);
        }, quieto ? 0 : 170);
        setTimeout(() => {
          portada.classList.remove('dispara');
          ocupado = false;
          programar();
        }, quieto ? 50 : 520);
      }, quieto ? 0 : 220);
    };

    portada.querySelector('[data-disparar]')!.addEventListener('click', disparar);

    // El punto de enfoque sigue al ratón; tocar la foto enfoca ahí y dispara
    const enfocar = (e: PointerEvent) => {
      const r = pantalla.getBoundingClientRect();
      enfoque.style.setProperty('--fx', `${((e.clientX - r.left) / r.width) * 100}%`);
      enfoque.style.setProperty('--fy', `${((e.clientY - r.top) / r.height) * 100}%`);
    };
    pantalla.addEventListener('pointermove', (e) => { if (fino.matches) enfocar(e); });
    pantalla.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      enfocar(e as PointerEvent);
      disparar();
    });

    portada.querySelector('[data-vaciar]')!.addEventListener('click', () => {
      elegidas.length = 0;
      copias.querySelectorAll('.nueva').forEach((c) => c.remove());
      pedir.hidden = true;
      ultima.hidden = true;
      aviso.textContent = 'Fotos reveladas quitadas';
    });

    // Al pedir presupuesto, las fotos elegidas viajan al formulario de contacto
    portada.querySelector('[data-pedir-ir]')?.addEventListener('click', () => {
      try { sessionStorage.setItem('clara-fotos-elegidas', JSON.stringify(elegidas.map((e) => e.alt))); } catch { /* sin almacenamiento */ }
    });

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; programar(); }).observe(pantalla);
    document.addEventListener('visibilitychange', programar);
    if (tomas[1]) setTimeout(() => precargar(tomas[1]), 1500);
    programar();
  }
</script>
