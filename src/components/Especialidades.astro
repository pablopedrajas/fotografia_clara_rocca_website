---
/**
 * Especialidades en tarjetas editoriales: foto vertical, nombre en mayúsculas
 * espaciadas y resumen. Las que aún no tienen fotos salen como enlaces de texto.
 */
import { ruta } from '../lib/ruta';
import type { Foto } from '../lib/fotos';
import { especialidades } from '../config/especialidades';

interface Props {
  fotos: Foto[];
  /** Especialidades que no se muestran (por ejemplo, bodas si ya va destacada encima) */
  excluir?: string[];
  antetitulo?: string;
  titulo?: string;
}
const { fotos, excluir = [], antetitulo = 'Especialidades', titulo = 'Qué fotografía Clara' } = Astro.props;

const portadaDe = (categorias: string[], portada?: string) => {
  const suyas = fotos.filter((f) => categorias.includes(f.categoria));
  return suyas.find((f) => f.archivo === portada) ?? suyas.find((f) => f.vertical) ?? suyas[0];
};
const lista = especialidades.filter((e) => !excluir.includes(e.slug)).map((e) => ({ e, foto: portadaDe(e.categorias, e.portada) }));
const conFoto = lista.filter((x) => x.foto);
const sinFoto = lista.filter((x) => !x.foto);
---

<section class="especialidades" id="especialidades" aria-labelledby="t-especialidades">
  <header class="intro revela">
    <span class="antetitulo">{antetitulo}</span>
    <h2 class="titulo-seccion" id="t-especialidades">{titulo}</h2>
  </header>

  <ul class="tarjetas" style={`--n:${Math.min(conFoto.length, 4)}`}>
    {conFoto.map(({ e, foto }, i) => (
      <li class="revela" style={`transition-delay:${i * 0.12}s`}>
        <a href={ruta(`/${e.slug}/`)}>
          <span class="marco">
            <img
              src={foto!.mini}
              srcset={foto!.srcset}
              sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 28vw"
              alt=""
              width={foto!.ancho}
              height={foto!.alto}
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="numero">{String(i + 1).padStart(2, '0')}</span>
          <h3>{e.nombre}</h3>
          <p>{e.resumen}</p>
          <span class="descubrir">Descubrir</span>
        </a>
      </li>
    ))}
  </ul>

  {sinFoto.length > 0 && (
    <p class="tambien revela">
      <span>También</span>
      {sinFoto.map(({ e }) => <a href={ruta(`/${e.slug}/`)}>{e.nombre}</a>)}
    </p>
  )}
</section>

<style>
  .especialidades { padding: clamp(5rem, 11vw, 9rem) var(--margen); }
  .intro { text-align: center; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .intro .titulo-seccion { margin: 0; }

  .tarjetas {
    list-style: none; margin: 0 auto; padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    max-width: 100rem;
  }
  /* Ritmo editorial: las tarjetas pares bajan un poco */
  .tarjetas li:nth-child(even) { margin-top: clamp(0rem, 6vw, 6rem); }
  .tarjetas a { display: grid; gap: .9rem; text-decoration: none; color: inherit; }
  .marco { display: block; overflow: hidden; }
  .marco img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: scale 1.4s var(--ease); }
  .tarjetas a:hover img { scale: 1.05; }
  .numero { font: 500 .68rem/1 var(--sans); letter-spacing: .24em; color: var(--grafito-suave); margin-top: .6rem; }
  h3 {
    margin: 0;
    font: 300 clamp(1.35rem, 2vw, 1.85rem)/1.2 var(--serif);
    text-transform: uppercase;
    letter-spacing: .14em;
  }
  .tarjetas p { margin: 0; color: var(--grafito-suave); max-width: 34ch; line-height: 1.5; }
  .descubrir {
    justify-self: start;
    font: 500 .68rem/1 var(--sans); letter-spacing: .24em; text-transform: uppercase;
    padding-bottom: .45rem; border-bottom: 1px solid currentColor;
    margin-top: .3rem;
  }

  .tambien {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .5rem 2rem;
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    text-align: center;
  }
  .tambien span { font: 500 .68rem/1 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--grafito-suave); }
  .tambien a {
    font: 300 clamp(1.4rem, 2.4vw, 2rem)/1.2 var(--serif); text-transform: uppercase; letter-spacing: .14em;
    text-decoration: none; color: inherit;
    border-bottom: 1px solid transparent; transition: border-color .3s;
  }
  .tambien a:hover { border-bottom-color: currentColor; font-style: italic; }

  @media (max-width: 1100px) {
    .tarjetas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .tarjetas { grid-template-columns: 1fr; }
    .tarjetas li:nth-child(even) { margin-top: 0; }
  }
</style>
