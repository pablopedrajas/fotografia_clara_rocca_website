---
import { ruta } from '../lib/ruta';
import type { Foto } from '../lib/fotos';
import { sitio } from '../config/sitio';
import { especialidades } from '../config/especialidades';

interface Props { fotos: Foto[] }
const { fotos } = Astro.props;

// Hasta tres fotos de cada especialidad, empezando por su portada
const fotosDe = (categorias: string[], portada?: string) => {
  const suyas = fotos.filter((f) => categorias.includes(f.categoria));
  const primera = suyas.find((f) => f.archivo === portada) ?? suyas.find((f) => f.seleccionada) ?? suyas[0];
  return primera ? [primera, ...suyas.filter((f) => f !== primera && f.vertical)].slice(0, 3) : [];
};
const ciudad = sitio.contacto.ciudad;
---

<section class="especialidades" id="especialidades" aria-labelledby="t-especialidades" data-especialidades>
  <div class="intro">
    <h2 class="titulo-seccion" id="t-especialidades">Fotógrafa en {ciudad || 'tu ciudad'}</h2>
    <p>
      Bodas, bautizos, comuniones, books de modelo, viajes y campañas para marcas. Clara lleva más de diez años en el
      sector, delante y detrás de la cámara, y elige qué fotos contar como lo haría con un carrete: mirando
      despacio. Pasa por encima de cada especialidad para ver su trabajo.
    </p>
  </div>
  <ul>
    {especialidades.map((e) => {
      const lote = fotosDe(e.categorias, e.portada);
      return (
        <li data-esp>
          <a href={ruta(`/${e.slug}/`)}>
            <span class="nombre">{e.nombre}</span>
            <span class="resumen">{e.resumen}</span>
            {lote.length > 0 && (
              <span class="miniaturas" aria-hidden="true">
                {lote.map((f) => <img src={f.micro} alt="" width={f.ancho} height={f.alto} loading="lazy" decoding="async" />)}
              </span>
            )}
            <span class="ir" aria-hidden="true">Ver más</span>
          </a>
          {lote.length > 0 && (
            <div class="abanico" aria-hidden="true" data-abanico>
              {lote.map((f, i) => (
                <span class="carta" style={`--i:${i}`}>
                  <img src={f.mini} alt="" width={f.ancho} height={f.alto} loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .especialidades { padding: clamp(5rem, 12vw, 10rem) var(--margen) clamp(4rem, 9vw, 7rem); position: relative; }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1rem 4rem;
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .intro .titulo-seccion { margin: 0; }
  .intro p { margin: 0; max-width: 46ch; color: var(--grafito-suave); line-height: 1.6; }

  ul { list-style: none; margin: 0; padding: 0; }
  li { position: relative; }
  li + li { border-top: 1px solid #c9cbc6; }
  a {
    display: grid;
    /* Columnas fijas: todos los nombres, resúmenes y enlaces quedan alineados entre filas */
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) 6.5rem;
    align-items: center;
    gap: 1rem 2rem;
    padding: clamp(1rem, 2.5vw, 1.75rem) 0;
    text-decoration: none;
  }
  .nombre {
    font: 400 clamp(2.25rem, 6.5vw, 5.25rem)/1 var(--serif);
    letter-spacing: -0.025em;
    transition: translate .4s var(--ease), color .3s;
  }
  .resumen { justify-self: start; max-width: 32ch; color: var(--grafito-suave); line-height: 1.45; }
  .ir { justify-self: end; font-size: .9375rem; white-space: nowrap; opacity: 0; translate: -.5rem 0; transition: opacity .3s, translate .3s var(--ease); }
  .ir::after { content: ''; display: inline-block; width: 1.4rem; height: 2px; margin-left: .5rem; vertical-align: middle; background: var(--lapiz); }

  .miniaturas { display: none; }
  @media (min-width: 1200px) {
    a { grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) 12rem 6.5rem; }
    .miniaturas { display: flex; justify-content: center; transition: opacity .3s; }
    .miniaturas img {
      width: clamp(3.5rem, 4.2vw, 5.5rem);
      aspect-ratio: 4 / 5; object-fit: cover;
      border: .25rem solid #fbfbf8;
      box-shadow: 0 8px 18px -8px rgba(0, 0, 0, .45);
      rotate: -4deg;
    }
    .miniaturas img + img { margin-left: -1rem; rotate: 3deg; }
    .miniaturas img:nth-child(3) { rotate: -1deg; }
    li.activa .miniaturas { opacity: 0; }
  }

  a:hover .nombre, a:focus-visible .nombre { translate: .35em 0; }
  a:hover .ir, a:focus-visible .ir { opacity: 1; translate: 0 0; }

  /* Abanico de fotos que sigue al cursor (solo con ratón) */
  .abanico {
    position: absolute;
    left: 0; top: 0;
    width: 11rem; height: 15rem;
    pointer-events: none;
    z-index: 4;
    opacity: 0;
    transition: opacity .25s;
    translate: var(--mx, 60vw) var(--my, 0);
  }
  .carta {
    position: absolute; inset: 0;
    background: var(--pelicula);
    padding: .35rem .35rem 1.4rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .25);
    transform-origin: 50% 110%;
    rotate: calc((var(--i) - 1) * 4deg);
    transition: rotate .45s var(--ease), translate .45s var(--ease);
  }
  .carta img { width: 100%; height: 100%; object-fit: cover; }
  li.activa .abanico { opacity: 1; }
  li.activa .carta { rotate: calc((var(--i) - 1) * 13deg); translate: calc((var(--i) - 1) * 1.6rem) 0; }
  li.activa .carta:nth-child(2) { z-index: 1; }
  li.activa .nombre { color: var(--pelicula); }
  .especialidades:has(li.activa) li:not(.activa) .nombre { color: #a6aaa6; }

  @media (hover: none), (pointer: coarse) {
    .abanico { display: none; }
    .ir { opacity: 1; translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nombre, .carta, .ir { transition: none; }
  }
  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    a { grid-template-columns: 1fr; gap: .4rem; }
    .ir { justify-self: start; }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-especialidades]');
  if (seccion && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    seccion.querySelectorAll<HTMLElement>('[data-esp]').forEach((li) => {
      const abanico = li.querySelector<HTMLElement>('[data-abanico]');
      if (!abanico) return;
      let raf = 0, x = 0, y = 0;
      const mover = () => {
        raf = 0;
        const r = li.getBoundingClientRect();
        abanico.style.setProperty('--mx', `${x - r.left - abanico.offsetWidth / 2}px`);
        abanico.style.setProperty('--my', `${y - r.top - abanico.offsetHeight * 0.75}px`);
      };
      li.addEventListener('pointerenter', (e) => { x = e.clientX; y = e.clientY; mover(); li.classList.add('activa'); });
      li.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; if (!raf) raf = requestAnimationFrame(mover); });
      li.addEventListener('pointerleave', () => li.classList.remove('activa'));
    });
  }
</script>
