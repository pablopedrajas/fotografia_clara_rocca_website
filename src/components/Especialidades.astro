---
import type { Foto } from '../lib/fotos';
import { especialidades } from '../config/especialidades';

interface Props { fotos: Foto[] }
const { fotos } = Astro.props;

const portadaDe = (categoria: string) =>
  fotos.find((f) => f.categoria === categoria && f.seleccionada) ?? fotos.find((f) => f.categoria === categoria);
---

<section class="especialidades" id="especialidades" aria-labelledby="t-especialidades">
  <h2 class="titulo-seccion" id="t-especialidades">Especialidades</h2>
  <ul>
    {especialidades.map((e) => {
      const foto = portadaDe(e.categoria);
      return (
        <li>
          <a href={`/${e.slug}/`}>
            <span class="nombre">{e.nombre}</span>
            <span class="resumen">{e.resumen}</span>
            {foto && (
              <span class="fotograma" aria-hidden="true">
                <img src={foto.mini} alt="" width={foto.ancho} height={foto.alto} loading="lazy" decoding="async" />
              </span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .especialidades { padding: clamp(5rem, 12vw, 10rem) var(--margen) clamp(4rem, 9vw, 7rem); }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid #c9cbc6; }
  a {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) 7.5rem;
    align-items: center;
    gap: 1rem 2rem;
    padding: clamp(1rem, 2.5vw, 1.75rem) 0;
    text-decoration: none;
  }
  .nombre {
    font: 400 clamp(2.25rem, 6.5vw, 5.25rem)/1 var(--serif);
    letter-spacing: -0.025em;
    transition: translate .4s var(--ease);
  }
  .resumen { max-width: 32ch; color: var(--grafito-suave); line-height: 1.45; }

  /* Miniatura como un fotograma de la tira, con su borde negro */
  .fotograma {
    grid-column: 3;
    aspect-ratio: 3 / 2;
    padding: .3rem;
    background: var(--pelicula);
    rotate: -2deg;
    transition: rotate .4s var(--ease), scale .4s var(--ease);
  }
  .fotograma img { width: 100%; height: 100%; object-fit: cover; }

  a:hover .nombre, a:focus-visible .nombre { translate: .4em 0; }
  a:hover .fotograma, a:focus-visible .fotograma { rotate: 1deg; scale: 1.12; }
  a:hover .nombre { text-decoration: underline 2px var(--lapiz); text-underline-offset: .15em; }

  @media (prefers-reduced-motion: reduce) {
    .nombre, .fotograma { transition: none; }
  }
  @media (max-width: 720px) {
    a { grid-template-columns: 1fr; gap: .4rem; }
    .fotograma { display: none; }
  }
</style>
