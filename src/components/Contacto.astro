---
import { sitio } from '../config/sitio';
import { especialidades } from '../config/especialidades';

interface Props { tipo?: string }
const { tipo } = Astro.props;
const opciones = [...new Set([...especialidades.map((e) => e.nombre), ...sitio.servicios])];
const { email, telefono, instagram, ciudad } = sitio.contacto;
const hayContacto = email || telefono || instagram;
const telLimpio = telefono.replace(/[^\d+]/g, '');
---

{hayContacto && (
  <section class="contacto" id="contacto" aria-labelledby="t-contacto">
    <div class="intro">
      <span class="antetitulo">Contacto</span>
      <h2 class="titulo-seccion" id="t-contacto">Hablemos de tu día</h2>
      <p>Cuéntale a Clara qué tienes en mente y te responderá con disponibilidad y presupuesto.</p>
      <ul class="vias">
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {telefono && <li><a href={`tel:${telLimpio}`}>{telefono}</a></li>}
        {telefono && <li><a href={`https://wa.me/${telLimpio.replace('+', '')}`} rel="noopener">WhatsApp</a></li>}
        {instagram && <li><a href={`https://instagram.com/${instagram}`} rel="noopener">Instagram</a></li>}
        {ciudad && <li class="ciudad">{ciudad}</li>}
      </ul>
    </div>

    {email && (
      <form class="formulario" data-form data-email={email}>
        <label>
          <span>Tu nombre</span>
          <input name="nombre" id="nombre-contacto" autocomplete="name" required />
        </label>
        <label>
          <span>Tipo de sesión</span>
          <select name="tipo" id="tipo">
            {opciones.map((o) => <option selected={o === tipo}>{o}</option>)}
            <option>Otra cosa</option>
          </select>
        </label>
        <label>
          <span>Fecha aproximada</span>
          <input name="fecha" id="fecha" placeholder="Por ejemplo, finales de noviembre" />
        </label>
        <label>
          <span>Qué tienes en mente</span>
          <textarea name="mensaje" id="mensaje" rows="5" required></textarea>
        </label>
        <button type="submit">Escribir a Clara</button>
        <p class="nota">Se abrirá tu programa de correo con el mensaje ya preparado.</p>
      </form>
    )}
  </section>
)}

<style>
  .contacto {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    padding: clamp(5rem, 11vw, 9rem) var(--margen);
    background: var(--papel-hondo);
  }
  .intro p { max-width: 34ch; font-size: var(--t-1); line-height: 1.45; margin: 0 0 2.5rem; color: var(--grafito-suave); font-style: italic; }
  .vias { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .vias a {
    font: 500 .75rem/1.4 var(--sans); letter-spacing: .2em; text-transform: uppercase;
    text-decoration: none; overflow-wrap: anywhere;
    padding-bottom: .3rem; border-bottom: 1px solid transparent; transition: border-color .3s;
  }
  .vias a:hover, .vias a:focus-visible { border-bottom-color: currentColor; }
  .ciudad { font: 500 .75rem/1.4 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--grafito-suave); }

  .formulario { display: grid; gap: 1.6rem; align-content: start; }
  label { display: grid; gap: .35rem; }
  label span { font: 500 .68rem/1.4 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--grafito-suave); }
  input, select, textarea {
    font: 400 1.2rem/1.4 var(--serif);
    color: var(--grafito);
    background: transparent;
    border: 0;
    border-bottom: 1px solid #c4bfb6;
    padding: .5rem 0;
    border-radius: 0;
  }
  textarea { resize: vertical; }
  input::placeholder { color: #a39e95; font-style: italic; }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom-color: var(--grafito); }
  .formulario button {
    justify-self: start;
    margin-top: .5rem;
    padding: 1.15rem 2.2rem;
    background: var(--grafito);
    color: var(--papel);
    border: 1px solid var(--grafito);
    font: 500 .75rem/1 var(--sans); letter-spacing: .22em; text-transform: uppercase;
    cursor: pointer;
    transition: background .3s, color .3s;
  }
  .formulario button:hover { background: transparent; color: var(--grafito); }
  .nota { margin: 0; font-size: 1rem; font-style: italic; color: var(--grafito-suave); }

  @media (max-width: 900px) { .contacto { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  // Fotos que la persona reveló en el visor de la portada
  try {
    const guardadas = JSON.parse(sessionStorage.getItem('clara-fotos-elegidas') || '[]') as string[];
    const area = form?.querySelector<HTMLTextAreaElement>('textarea');
    if (area && guardadas.length && !area.value) {
      area.value = `Me han gustado estas fotos de tu web:\n${guardadas.map((a) => `- ${a}`).join('\n')}\n\n`;
      sessionStorage.removeItem('clara-fotos-elegidas');
    }
  } catch { /* sin almacenamiento */ }
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const tipo = (d.get('tipo') as string) || '';
    const asunto = `${tipo && tipo !== 'Otra cosa' ? tipo : 'Sesión de fotos'}: ${d.get('nombre')}`;
    const lineas = [`Hola Clara, soy ${d.get('nombre')}.`];
    if (tipo) lineas.push(`Me interesa: ${tipo}.`);
    if (d.get('fecha')) lineas.push(`Fecha aproximada: ${d.get('fecha')}.`);
    lineas.push('', String(d.get('mensaje')));
    const cuerpo = lineas.join('\n');
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });
</script>
