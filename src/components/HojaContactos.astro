---
import type { Foto } from '../lib/fotos';
import { sitio } from '../config/sitio';

interface Props { fotos: Foto[] }
const { fotos } = Astro.props;

const POR_TIRA = 9;
const TIRAS = 5;
const total = POR_TIRA * TIRAS;

// Rellena la hoja repitiendo las fotos si hay menos de 36
const fotogramas = Array.from({ length: total }, (_, i) => (fotos.length ? fotos[i % fotos.length] : null));

// Fotogramas marcados con lápiz graso: las fotos «seleccionada».
// Cada una se coloca en una tira distinta y en una columna central, que son
// las que se ven enteras aunque la hoja se salga por los lados.
const elegidas = fotos.filter((f) => f.seleccionada).slice(0, 3);
const huecos = [1 * POR_TIRA + 3, 2 * POR_TIRA + 5, 3 * POR_TIRA + 4];
const ordenMarca: number[] = [];
elegidas.forEach((foto, k) => {
  const destino = huecos[k];
  const actual = fotogramas.findIndex((f, i) => f?.id === foto.id && !ordenMarca.includes(i));
  if (actual >= 0 && actual !== destino) {
    [fotogramas[actual], fotogramas[destino]] = [fotogramas[destino], fotogramas[actual]];
  } else if (actual < 0) {
    fotogramas[destino] = foto;
  }
  ordenMarca.push(destino);
});

// Trazos de lápiz a mano alzada (viewBox 150×100, el fotograma es 3:2)
const trazos = [
  'M18 56 C 14 22, 70 6, 118 14 C 150 20, 152 70, 120 88 C 86 104, 22 96, 12 66 C 8 52, 30 30, 62 24',
  'M136 30 C 120 6, 36 4, 14 34 C -2 58, 30 96, 84 94 C 132 92, 150 64, 138 38 C 132 26, 112 18, 96 16',
  'M24 26 C 54 4, 128 2, 140 40 C 150 76, 112 98, 64 96 C 18 94, 4 64, 14 40 C 18 30, 32 22, 50 18',
];

// Numeración real del borde de un carrete: 1, 1A, 2, 2A…
const numero = (i: number) => i + 1;
---

<section class="portada" aria-labelledby="nombre" data-portada>
  <div class="mesa">
    <div class="hoja" data-hoja>
      {Array.from({ length: TIRAS }, (_, t) => (
        <div class="tira">
          <div class="canto" aria-hidden="true">
            <span>{sitio.nombre.toUpperCase()} 400</span>
            <span class="perforaciones"></span>
            <span>{sitio.nombre.toUpperCase()} 400</span>
          </div>
          <div class="fotogramas">
            {fotogramas.slice(t * POR_TIRA, (t + 1) * POR_TIRA).map((f, k) => {
              const i = t * POR_TIRA + k;
              const m = ordenMarca.indexOf(i);
              return f ? (
                <button
                  class:list={['fotograma', { vertical: f.vertical, marcado: m >= 0 }]}
                  data-marcar={f.id}
                  data-alt={f.alt}
                  data-mini={f.mini}
                  aria-pressed="false"
                  aria-label={`Marcar como favorita: ${f.alt}`}
                  tabindex={i < fotos.length ? 0 : -1}
                  aria-hidden={i < fotos.length ? undefined : 'true'}
                >
                  <span class="encuadre"><img src={f.micro} alt="" width={f.ancho} height={f.alto} decoding="async" fetchpriority={i < 4 ? 'high' : 'auto'} /></span>
                  {m >= 0 && (
                    <svg class="marca" viewBox="-10 -10 170 120" aria-hidden="true" style={`--orden:${m}`}>
                      <path d={trazos[m % trazos.length]} pathLength="1" />
                    </svg>
                  )}
                </button>
              ) : (
                <span class="fotograma vacio" aria-hidden="true"></span>
              );
            })}
          </div>
          <div class="canto numeros" aria-hidden="true">
            {Array.from({ length: POR_TIRA }, (_, k) => {
              const n = numero(t * POR_TIRA + k);
              return (<><span>{n}</span><span class="flecha">▸{n}A</span></>);
            })}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="lupa" aria-hidden="true" data-lupa><div class="lupa-campo" data-lupa-campo></div></div>

  <header class="rotulo">
    <h1 id="nombre">{sitio.nombre}</h1>
    <div class="lema">
      <p>{sitio.lema}</p>
      <p class="pista-lapiz">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l3.5-1 12-12a2.1 2.1 0 0 0-3-3l-12 12L3 21z" /></svg>
        Toca las fotos que te gusten: Clara las rodea con su lápiz y te las guarda.
      </p>
    </div>
  </header>

  <aside class="bandeja" data-bandeja hidden aria-live="polite" aria-label="Tus fotos marcadas">
    <div class="bandeja-fotos" data-bandeja-fotos></div>
    <p class="bandeja-texto"><span data-bandeja-n>0</span> <span data-bandeja-palabra>fotos marcadas</span></p>
    <a class="bandeja-cta" href="#contacto" data-bandeja-pedir>Pedir presupuesto con estas fotos</a>
    <button class="bandeja-borrar" data-bandeja-borrar aria-label="Borrar mis marcas">×</button>
  </aside>
</section>

<style>
  .portada {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    padding-top: 4.5rem;
  }

  /* La hoja se inclina y se sale de los bordes, como apoyada en la mesa */
  .mesa {
    position: relative;
    overflow: hidden;
    min-height: 58svh;
  }
  .hoja {
    position: absolute;
    left: 50%; top: 50%;
    width: max(122vw, 1300px);
    translate: -50% -50%;
    rotate: -2.2deg;
    display: grid;
    gap: clamp(.6rem, 1.4vw, 1.2rem);
    padding: 1.4rem 0;
  }

  .tira {
    background: var(--pelicula);
    color: var(--ambar);
    padding: 0 1rem;
    box-shadow: 0 1px 0 rgba(0, 0, 0, .25);
  }
  .canto {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 1.55rem;
    font: 500 .72rem/1 var(--borde);
    letter-spacing: .08em;
    white-space: nowrap;
  }
  .perforaciones {
    flex: 1;
    height: .55rem;
    background: repeating-linear-gradient(90deg, #262626 0 .75rem, transparent .75rem 1.35rem);
    border-radius: 2px;
    opacity: .9;
  }
  .numeros { justify-content: space-around; }
  .numeros .flecha { opacity: .75; }

  .fotogramas {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: .9rem;
  }
  .fotograma {
    position: relative;
    aspect-ratio: 3 / 2;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: #121212;
    overflow: visible;
    cursor: zoom-in;
  }
  .encuadre {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 3px;
  }
  .fotograma img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  /* Las verticales aparecen giradas, como en un contacto de verdad */
  .fotograma.vertical img {
    position: absolute;
    left: 50%; top: 50%;
    width: 66.667%;
    height: 150%;
    translate: -50% -50%;
    rotate: -90deg;
  }

  .vacio { cursor: default; }

  /* Lápiz graso */
  .marca {
    position: absolute;
    inset: -12% -10%;
    width: 120%; height: 124%;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
  }
  .marca path {
    fill: none;
    stroke: var(--lapiz);
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    filter: url(#cera);
    opacity: .92;
  }

  /* ── Revelado: la hoja aparece como en la cubeta y luego se marcan las elegidas ── */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hoja img {
      animation: revelar 2.4s var(--ease) both;
      animation-delay: calc(var(--d, 0) * 1ms);
    }
    :global(.js) .marca path {
      stroke-dashoffset: 1;
      animation: trazar .9s cubic-bezier(.6, .1, .3, 1) forwards;
      animation-delay: calc(2.2s + var(--orden) * .55s);
    }
  }
  @keyframes revelar {
    from { filter: brightness(4) contrast(.2) grayscale(1); opacity: .15; }
    60% { filter: brightness(1.15) contrast(.9) grayscale(.6); opacity: 1; }
    to { filter: none; opacity: 1; }
  }
  @keyframes trazar { to { stroke-dashoffset: 0; } }

  /* ── Lupa ── */
  .lupa {
    --r: 130px;
    position: absolute;
    left: 0; top: 0;
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: .6;
    transition: opacity .25s, scale .35s var(--ease);
    box-shadow:
      0 0 0 6px #111,
      0 0 0 7px rgba(255, 255, 255, .25),
      0 22px 50px rgba(0, 0, 0, .55);
    z-index: 5;
    background: var(--papel);
  }
  .lupa::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, .28), transparent 38%),
      radial-gradient(circle, transparent 62%, rgba(0, 0, 0, .35));
  }
  .lupa.activa { opacity: 1; scale: 1; }
  .lupa-campo {
    position: absolute;
    left: 0; top: 0;
    transform-origin: 0 0;
  }
  :global(.con-lupa) .mesa { cursor: none; }
  :global(.con-lupa) .fotograma { cursor: none; }
  .fotograma { cursor: pointer; }

  /* ── Rótulo ── */
  .rotulo {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: .5rem 2rem;
    padding: clamp(.75rem, 2vw, 1.5rem) var(--margen) clamp(1.25rem, 3vw, 2.25rem);
    background: var(--papel);
  }
  h1 {
    margin: 0;
    font: 400 clamp(4rem, 17.5vw, 17rem)/0.8 var(--serif);
    font-optical-sizing: auto;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
  }
  .lema { display: grid; gap: .6rem; margin-bottom: .4em; max-width: 34ch; }
  .lema p {
    margin: 0;
    font-size: var(--t-0);
    line-height: 1.45;
    color: var(--grafito-suave);
  }
  .lema .pista-lapiz {
    display: flex; gap: .5rem; align-items: flex-start;
    font-size: .9375rem; color: var(--grafito);
  }
  .pista-lapiz svg { flex: 0 0 1.15rem; width: 1.15rem; height: 1.15rem; fill: none; stroke: var(--lapiz); stroke-width: 2; stroke-linejoin: round; margin-top: .1rem; }

  /* Marcas del visitante: mismo lápiz, trazo dibujado en el momento */
  .fotograma[aria-pressed='true'] { z-index: 3; }
  :global(.marca-mia path) {
    fill: none; stroke: var(--lapiz); stroke-width: 6.5;
    stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 0;
    filter: url(#cera);
    animation: trazar .55s cubic-bezier(.6, .1, .3, 1) both;
  }
  :global(.marca-mia) { position: absolute; inset: -12% -10%; width: 120%; height: 124%; overflow: visible; pointer-events: none; z-index: 2; }
  @media (prefers-reduced-motion: reduce) { :global(.marca-mia path) { animation: none; } }

  /* Bandeja con la selección */
  .bandeja {
    position: fixed;
    left: 50%; bottom: max(1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    z-index: 25;
    display: flex; align-items: center; gap: .9rem;
    padding: .55rem .6rem .55rem .7rem;
    background: var(--pelicula); color: var(--papel);
    box-shadow: 0 14px 40px rgba(0, 0, 0, .35);
    max-width: calc(100vw - 2rem);
  }
  .bandeja[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .bandeja:not([hidden]) { animation: subir .35s var(--ease); }
  }
  @keyframes subir { from { translate: -50% 120%; } }
  .bandeja-fotos { display: flex; flex: 0 0 auto; }
  .bandeja-fotos :global(button) { padding: 0; border: 2px solid var(--pelicula); background: none; cursor: zoom-in; margin-left: -.6rem; }
  .bandeja-fotos :global(button:first-child) { margin-left: 0; }
  .bandeja-fotos :global(img) { width: 2.6rem; height: 2.6rem; object-fit: cover; display: block; }
  .bandeja-texto { margin: 0; font: 500 .8rem/1.2 var(--borde); color: var(--ambar); letter-spacing: .05em; white-space: nowrap; }
  .bandeja-cta { background: var(--lapiz); color: #fff; text-decoration: none; padding: .6rem .9rem; font-weight: 600; font-size: .9rem; white-space: nowrap; }
  .bandeja-cta:hover { background: #b52a22; }
  .bandeja-borrar { background: none; border: 0; color: #9a9ea2; font-size: 1.4rem; line-height: 1; cursor: pointer; padding: .2rem .35rem; }
  @media (max-width: 560px) {
    .bandeja { gap: .6rem; }
    .bandeja-texto { display: none; }
    .bandeja-cta { font-size: .82rem; padding: .55rem .7rem; }
  }

  @media (max-width: 720px) {
    .hoja { width: 290vw; rotate: -3deg; }
    .canto { font-size: .6rem; height: 1.25rem; }
    .fotogramas { gap: .5rem; }
    .lupa { display: none; }
  }
</style>

<script>
  const portada = document.querySelector<HTMLElement>('[data-portada]');
  const hoja = portada?.querySelector<HTMLElement>('[data-hoja]');
  const lupa = portada?.querySelector<HTMLElement>('[data-lupa]');
  const campo = portada?.querySelector<HTMLElement>('[data-lupa-campo]');
  const mesa = portada?.querySelector<HTMLElement>('.mesa');

  // Revelado escalonado desde la esquina superior izquierda, como el revelador entrando en la cubeta
  hoja?.querySelectorAll<HTMLImageElement>('img').forEach((img, i) => {
    const fila = Math.floor(i / 9), col = i % 9;
    img.style.setProperty('--d', String((fila + col) * 110));
  });

  // ── Favoritas: el visitante marca fotos con el lápiz ──
  const trazosMios = [
    'M20 60 C 12 24, 74 4, 120 16 C 152 26, 150 74, 116 90 C 80 106, 18 94, 12 62',
    'M132 28 C 112 4, 34 6, 14 36 C 0 62, 34 98, 88 94 C 134 90, 150 60, 136 36',
    'M26 30 C 58 2, 132 6, 142 44 C 150 80, 108 100, 60 96 C 16 92, 2 60, 16 38',
  ];
  const bandeja = document.querySelector<HTMLElement>('[data-bandeja]');
  const fotosBandeja = document.querySelector<HTMLElement>('[data-bandeja-fotos]');
  const nBandeja = document.querySelector<HTMLElement>('[data-bandeja-n]');
  const palabra = document.querySelector<HTMLElement>('[data-bandeja-palabra]');
  const marcadas = new Map<string, { alt: string; mini: string }>();

  const pintarBandeja = () => {
    if (!bandeja || !fotosBandeja || !nBandeja || !palabra) return;
    bandeja.hidden = marcadas.size === 0;
    nBandeja.textContent = String(marcadas.size);
    palabra.textContent = marcadas.size === 1 ? 'foto marcada' : 'fotos marcadas';
    fotosBandeja.innerHTML = '';
    [...marcadas].slice(-5).forEach(([id, d]) => {
      const b = document.createElement('button');
      b.dataset.abrir = id;
      b.setAttribute('aria-label', `Ampliar: ${d.alt}`);
      b.innerHTML = `<img src="${d.mini}" alt="">`;
      fotosBandeja.appendChild(b);
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-marcar]').forEach((b, k) => {
    b.addEventListener('click', () => {
      const id = b.dataset.marcar!;
      const ya = marcadas.has(id);
      // la misma foto puede salir varias veces en la hoja: se marcan todas sus copias
      document.querySelectorAll<HTMLButtonElement>(`[data-marcar="${id}"]`).forEach((copia) => {
        copia.setAttribute('aria-pressed', String(!ya));
        copia.querySelector('.marca-mia')?.remove();
        if (!ya) {
          copia.insertAdjacentHTML(
            'beforeend',
            `<svg class="marca-mia" viewBox="-10 -10 170 120" aria-hidden="true"><path pathLength="1" d="${trazosMios[k % trazosMios.length]}"/></svg>`,
          );
        }
      });
      if (ya) marcadas.delete(id);
      else marcadas.set(id, { alt: b.dataset.alt || '', mini: b.dataset.mini || '' });
      pintarBandeja();
    });
  });

  document.querySelector('[data-bandeja-borrar]')?.addEventListener('click', () => {
    document.querySelectorAll('[data-marcar][aria-pressed="true"]').forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      b.querySelector('.marca-mia')?.remove();
    });
    marcadas.clear();
    pintarBandeja();
  });

  // Lleva la selección al formulario de contacto
  document.querySelector('[data-bandeja-pedir]')?.addEventListener('click', () => {
    const area = document.querySelector<HTMLTextAreaElement>('#contacto textarea');
    if (!area || !marcadas.size) return;
    const lista = [...marcadas.values()].map((d) => `- ${d.alt}`).join('\n');
    const texto = `Me han gustado estas fotos de tu web:\n${lista}\n\n`;
    if (!area.value.includes('Me han gustado estas fotos')) area.value = texto + area.value;
    setTimeout(() => area.focus({ preventScroll: true }), 600);
  });

  const finoYHover = matchMedia('(hover: hover) and (pointer: fine)');
  const ESCALA = 2.6;

  if (portada && hoja && lupa && campo && mesa && finoYHover.matches) {
    document.documentElement.classList.add('con-lupa');

    // El campo de la lupa es una copia de la mesa entera, ampliada
    const copia = mesa.cloneNode(true) as HTMLElement;
    copia.querySelectorAll('button').forEach((b) => b.setAttribute('tabindex', '-1'));
    copia.querySelectorAll('.marca path').forEach((p) => ((p as SVGPathElement).style.animation = 'none'));
    copia.querySelectorAll<HTMLImageElement>('img').forEach((img) => (img.style.animation = 'none'));
    campo.appendChild(copia);

    const ajustar = () => {
      const r = mesa.getBoundingClientRect();
      copia.style.width = r.width + 'px';
      copia.style.height = r.height + 'px';
    };
    ajustar();
    addEventListener('resize', ajustar);

    let rafId = 0;
    let px = 0, py = 0;
    const mover = () => {
      rafId = 0;
      const rm = mesa.getBoundingClientRect();
      const rp = portada.getBoundingClientRect();
      const radio = lupa.offsetWidth / 2;
      const x = px - rm.left, y = py - rm.top;
      lupa.style.translate = `${px - rp.left - radio}px ${py - rp.top - radio}px`;
      campo.style.transform = `translate(${radio - x * ESCALA}px, ${radio - y * ESCALA}px) scale(${ESCALA})`;
    };

    mesa.addEventListener('pointermove', (e) => {
      px = e.clientX; py = e.clientY;
      lupa.classList.add('activa');
      if (!rafId) rafId = requestAnimationFrame(mover);
    });
    mesa.addEventListener('pointerleave', () => lupa.classList.remove('activa'));
    addEventListener('scroll', () => lupa.classList.remove('activa'), { passive: true });
  }
</script>
