---
/**
 * Cabecera de las páginas interiores: migas, título grande y entradilla.
 * Con `fotos`, dos copias reveladas ocupan el lado derecho en pantallas anchas
 * (y en móvil solo si `fotosEnMovil`).
 */
import { ruta } from '../lib/ruta';
import { sitio } from '../config/sitio';
import type { Foto } from '../lib/fotos';

interface Props {
  titulo: string;
  actual: string;
  entradilla?: string;
  fotos?: (Foto | undefined)[];
  fotosEnMovil?: boolean;
}
const { titulo, actual, entradilla, fotos = [], fotosEnMovil = false } = Astro.props;
const copias = fotos.filter((f): f is Foto => !!f).slice(0, 2);
---

<header class:list={['cabecera', { 'con-fotos': copias.length > 0, 'fotos-movil': fotosEnMovil }]}>
  <div class="texto">
    <p class="migas"><a href={ruta('/')}>{sitio.nombre}</a> <span aria-hidden="true">/</span> {actual}</p>
    <h1>{titulo}</h1>
    {entradilla && <p class="entradilla">{entradilla}</p>}
    <slot />
  </div>
  {copias.length > 0 && (
    <div class="fotos" aria-hidden="true">
      {copias.map((f, i) => (
        <span class:list={['copia', i === 0 ? 'grande' : 'pequena']}>
          <img
            src={f.mini}
            srcset={f.srcset}
            sizes={i === 0 ? '(max-width: 1000px) 45vw, 24vw' : '(max-width: 1000px) 40vw, 15vw'}
            alt=""
            loading={fotosEnMovil ? 'eager' : 'lazy'}
            width={f.ancho}
            height={f.alto}
            decoding="async"
          />
        </span>
      ))}
    </div>
  )}
</header>

<style>
  .cabecera {
    padding: clamp(8rem, 15vw, 11rem) var(--margen) clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    max-width: 110rem;
    margin: 0 auto;
  }
  .texto { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); align-content: center; }
  .migas { margin: 0; font: 500 .68rem/1.4 var(--sans); letter-spacing: .22em; text-transform: uppercase; color: var(--grafito-suave); }
  .migas a { color: var(--grafito); text-decoration: none; border-bottom: 1px solid currentColor; }
  h1 {
    margin: 0;
    max-width: 16ch;
    font: 300 clamp(2.3rem, 5.2vw, 5rem)/1.12 var(--serif);
    letter-spacing: .1em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .entradilla {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-style: italic;
    line-height: 1.45;
    color: var(--grafito-suave);
  }

  .fotos { position: relative; display: none; }
  .copia { display: block; }
  .copia img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .grande { width: clamp(15rem, 26vw, 32rem); margin-left: auto; }
  .pequena {
    position: absolute; left: 0; bottom: -2.5rem;
    width: clamp(9rem, 13vw, 17rem);
    outline: .6rem solid var(--papel);
  }

  @media (min-width: 1000px) {
    .cabecera.con-fotos { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .con-fotos .fotos { display: block; padding: 0 0 2.5rem clamp(5rem, 9vw, 11rem); }
  }
  @media (max-width: 999px) {
    .fotos-movil .fotos { display: flex; align-items: flex-start; padding: .5rem 0 1.5rem; }
    .fotos-movil .copia { position: static; width: 58%; }
    .fotos-movil .pequena { width: 40%; margin: 3rem 0 0 2%; outline: 0; }
    .fotos-movil .grande { margin: 0; }
  }
</style>
