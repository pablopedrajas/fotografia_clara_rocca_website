---
/**
 * Menú principal, estilo editorial: nombre centrado, enlaces en mayúsculas pequeñas
 * y un menú a pantalla completa. «Bodas» tiene su propio desplegable y su bloque
 * destacado dentro del menú completo.
 * Con `sobreFoto`, la barra empieza transparente sobre la foto de portada.
 */
import { ruta } from '../lib/ruta';
import { sitio } from '../config/sitio';
import { especialidades } from '../config/especialidades';
import { cargarFotos } from '../lib/fotos';

interface Props { hayTrabajo: boolean; hayContacto: boolean; sobreFoto?: boolean }
const { hayTrabajo, hayContacto, sobreFoto = false } = Astro.props;

const fotos = await cargarFotos();
const fotoBoda = fotos.find((f) => f.archivo === 'boda-novios-espaldas-mar.jpg') ?? fotos.find((f) => f.categoria === 'Bodas');
const hayBoda = fotos.some((f) => f.fotograma);

const apartadosBoda = [
  { href: '/bodas/', texto: 'Fotógrafa de bodas' },
  ...(hayBoda
    ? [
        { href: '/bodas/#boda-real', texto: 'Una boda real, entera' },
        { href: '/bodas/#momentos', texto: 'Momento a momento' },
        { href: '/bodas/#color-o-blanco-y-negro', texto: 'Color o blanco y negro' },
      ]
    : []),
  { href: '/bodas/#preguntas', texto: 'Preguntas frecuentes' },
];
const actual = Astro.url.pathname;
const esActual = (p: string) => (actual === ruta(p) ? 'page' : undefined);
const { email, instagram } = sitio.contacto;
---

<header class:list={['barra', { 'sobre-foto': sobreFoto }]} data-barra>
  <nav class="lado izq" aria-label="Principal">
    <button class="abrir" type="button" aria-label="Abrir el menú" aria-expanded="false" aria-controls="menu-completo" data-abrir-menu>
      <span class="hamburguesa" aria-hidden="true"><i></i><i></i></span>
      <span class="texto-abrir">Menú</span>
    </button>
    <div class="bodas-desp">
      <a class="enlace destacado" href={ruta('/bodas/')} aria-current={esActual('/bodas/')}>Bodas</a>
      <ul class="desplegable">
        {apartadosBoda.slice(1).map((a) => <li><a href={ruta(a.href)}>{a.texto}</a></li>)}
        {hayContacto && <li><a href={ruta('/bodas/#contacto')}>Consultar tu fecha</a></li>}
      </ul>
    </div>
    {hayTrabajo && <a class="enlace solo-ancho" href={ruta('/portfolio/')} aria-current={esActual('/portfolio/')}>Portfolio</a>}
  </nav>

  <a class="marca" href={ruta('/')} aria-label={`${sitio.nombre}, inicio`}>{sitio.nombre}</a>

  <nav class="lado der" aria-label="Secundario">
    <a class="enlace solo-ancho" href={ruta('/sobre-clara/')} aria-current={esActual('/sobre-clara/')}>Sobre Clara</a>
    {hayContacto && <a class="enlace reservar" href={ruta('/contacto/')}>Reservar</a>}
  </nav>
</header>

<div class="completo" id="menu-completo" hidden data-menu-completo>
  <div class="completo-cabecera">
    <button class="cerrar" type="button" data-cerrar-menu>Cerrar</button>
    <a class="marca" href={ruta('/')}>{sitio.nombre}</a>
    <span></span>
  </div>
  <div class="completo-cuerpo">
    <nav class="lista" aria-label="Todas las páginas">
      <ul>
        {especialidades.map((e) => (
          <li><a href={ruta(`/${e.slug}/`)} aria-current={esActual(`/${e.slug}/`)}>{e.nombre}</a></li>
        ))}
        {hayTrabajo && <li><a href={ruta('/portfolio/')} aria-current={esActual('/portfolio/')}>Portfolio</a></li>}
        <li><a href={ruta('/sobre-clara/')} aria-current={esActual('/sobre-clara/')}>Sobre Clara</a></li>
        {hayContacto && <li><a href={ruta('/contacto/')} aria-current={esActual('/contacto/')}>Contacto</a></li>}
      </ul>
    </nav>
    <aside class="bloque-bodas" aria-label="Bodas">
      {fotoBoda && <img src={fotoBoda.mini} alt="" width={fotoBoda.ancho} height={fotoBoda.alto} loading="lazy" decoding="async" />}
      <div>
        <span class="mini-titulo">Bodas en {sitio.contacto.ciudad || 'la playa'}</span>
        <ul>
          {apartadosBoda.map((a) => <li><a href={ruta(a.href)}>{a.texto}</a></li>)}
        </ul>
        {hayContacto && <a class="enlace-linea claro" href={ruta('/bodas/#contacto')}>Consultar disponibilidad</a>}
      </div>
    </aside>
  </div>
  <p class="completo-pie">
    {email && <a href={`mailto:${email}`}>{email}</a>}
    {instagram && <a href={`https://www.instagram.com/${instagram}/`} rel="noopener">Instagram</a>}
  </p>
</div>

<style>
  .barra {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem var(--margen);
    background: var(--papel);
    color: var(--grafito);
    border-bottom: 1px solid var(--linea);
    transition: background .5s, color .5s, border-color .5s, padding .5s var(--ease);
  }
  /* Sobre la foto de portada: transparente y en blanco hasta que se baja */
  .barra.sobre-foto:not(.solida) {
    background: transparent;
    color: #fff;
    border-bottom-color: transparent;
    padding-top: 1.9rem;
  }
  .barra.sobre-foto:not(.solida)::before {
    content: '';
    position: absolute; inset: 0 0 -3rem;
    background: linear-gradient(rgba(0, 0, 0, .35), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .barra a { color: inherit; text-decoration: none; }

  .lado { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2.4rem); }
  .der { justify-content: flex-end; }

  .marca {
    font: 400 clamp(1.15rem, 1.7vw, 1.6rem)/1 var(--serif);
    letter-spacing: .34em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-right: -.34em;
    text-decoration: none;
    color: inherit;
  }

  .enlace, .abrir {
    font: 500 .7rem/1 var(--sans);
    letter-spacing: .22em;
    text-transform: uppercase;
    padding: .55rem 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    position: relative;
  }
  .enlace::after {
    content: ''; position: absolute; left: 0; right: .22em; bottom: .15rem; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease);
  }
  .enlace:hover::after, .enlace[aria-current='page']::after, .destacado::after { transform: scaleX(1); }
  .abrir { display: inline-flex; align-items: center; gap: .75rem; }
  .hamburguesa { display: grid; gap: 5px; width: 1.4rem; }
  .hamburguesa i { display: block; height: 1px; background: currentColor; }
  .hamburguesa i:last-child { width: 65%; }
  .reservar { border: 1px solid currentColor; padding: .8rem 1.15rem; }
  .reservar::after { display: none; }
  .reservar:hover { background: var(--grafito); color: var(--papel); border-color: var(--grafito); }

  /* Desplegable de bodas */
  .bodas-desp { position: relative; }
  .desplegable {
    position: absolute; left: -1.25rem; top: 100%;
    min-width: 15rem;
    list-style: none; margin: .6rem 0 0; padding: 1rem 1.25rem;
    background: var(--papel); color: var(--grafito);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, .3);
    border: 1px solid var(--linea);
    opacity: 0; visibility: hidden; translate: 0 -.4rem;
    transition: opacity .3s, translate .3s var(--ease), visibility .3s;
  }
  .desplegable::before { content: ''; position: absolute; inset: -.8rem 0 auto; height: .8rem; }
  .bodas-desp:hover .desplegable, .bodas-desp:focus-within .desplegable { opacity: 1; visibility: visible; translate: 0 0; }
  .desplegable a { display: block; padding: .45rem 0; font: 400 1.15rem/1.3 var(--serif); }
  .desplegable a:hover { font-style: italic; }

  /* Menú a pantalla completa */
  .completo {
    position: fixed; inset: 0; z-index: 40;
    display: grid; grid-template-rows: auto 1fr auto;
    background: #0d0d0c; color: #f3f1ec;
    overflow-y: auto;
  }
  .completo[hidden] { display: none; }
  .completo a { color: inherit; text-decoration: none; }
  .completo-cabecera {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 1.35rem var(--margen);
  }
  .cerrar {
    justify-self: start;
    font: 500 .7rem/1 var(--sans); letter-spacing: .22em; text-transform: uppercase;
    background: none; border: 0; color: inherit; cursor: pointer; padding: .55rem 0;
  }
  .completo-cuerpo {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) var(--margen);
  }
  .lista ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .1rem; }
  .lista a {
    font: 300 clamp(1.7rem, 3.6vw, 3.2rem)/1.2 var(--serif);
    text-transform: uppercase; letter-spacing: .1em;
    transition: opacity .3s, padding .4s var(--ease);
  }
  .lista ul:hover a { opacity: .45; }
  .lista ul:hover a:hover, .lista a:focus-visible { opacity: 1; padding-left: .4em; font-style: italic; }
  .lista a[aria-current='page'] { font-style: italic; }

  .bloque-bodas { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.75rem; align-items: end; }
  .bloque-bodas img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .mini-titulo { display: block; font: 500 .7rem/1.4 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: #a8a49c; margin-bottom: 1rem; }
  .bloque-bodas ul { list-style: none; margin: 0 0 1.75rem; padding: 0; display: grid; gap: .35rem; }
  .bloque-bodas li a { font: 400 1.25rem/1.3 var(--serif); }
  .bloque-bodas li a:hover { font-style: italic; }

  .completo-pie {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 2.5rem;
    margin: 0; padding: 1.5rem var(--margen) 2rem;
    font: 500 .7rem/1.4 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: #a8a49c;
  }

  @media (max-width: 900px) {
    .solo-ancho, .desplegable, .reservar, .texto-abrir { display: none; }
    .barra { grid-template-columns: 1fr auto 1fr; padding-block: 1.1rem; }
    .barra.sobre-foto:not(.solida) { padding-top: 1.3rem; }
    .izq { gap: 0; }
    .izq .bodas-desp { position: absolute; right: var(--margen); top: 50%; translate: 0 -50%; }
    .marca { font-size: 1.05rem; letter-spacing: .28em; margin-right: -.28em; }
    .completo-cuerpo { grid-template-columns: 1fr; align-items: start; }
    .bloque-bodas { grid-template-columns: 7rem minmax(0, 1fr); align-items: start; }
    .completo-cabecera .marca { font-size: 1rem; }
  }
</style>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const panel = document.querySelector<HTMLElement>('[data-menu-completo]');
  const abrir = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');
  const cerrar = document.querySelector<HTMLButtonElement>('[data-cerrar-menu]');

  if (barra?.classList.contains('sobre-foto')) {
    const fijar = () => barra.classList.toggle('solida', scrollY > innerHeight * 0.6);
    fijar();
    addEventListener('scroll', fijar, { passive: true });
  }

  if (panel && abrir && cerrar) {
    const fijarMenu = (abierto: boolean) => {
      panel.hidden = !abierto;
      abrir.setAttribute('aria-expanded', String(abierto));
      document.documentElement.style.overflow = abierto ? 'hidden' : '';
      (abierto ? panel.querySelector<HTMLAnchorElement>('.lista a') : abrir)?.focus();
    };
    abrir.addEventListener('click', () => fijarMenu(true));
    cerrar.addEventListener('click', () => fijarMenu(false));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => fijarMenu(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) fijarMenu(false); });
  }
</script>
