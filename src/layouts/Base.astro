---
import { ruta } from '../lib/ruta';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/doto/latin-500.css';
import '../styles/global.css';
import { sitio } from '../config/sitio';
import { especialidades } from '../config/especialidades';
import type { Foto } from '../lib/fotos';
import Menu from '../components/Menu.astro';
import { negocio } from '../lib/negocio';

interface Props {
  titulo: string;
  descripcion: string;
  ogFoto?: Foto;
  jsonld?: object[];
  /** Si hay fotos en la web, el menú enlaza a «Trabajo» */
  hayTrabajo?: boolean;
  /** La página empieza con una foto a sangre: menú transparente encima */
  menuSobreFoto?: boolean;
}

const { titulo, descripcion, ogFoto, jsonld = [], hayTrabajo = false, menuSobreFoto = false } = Astro.props;
const { email, telefono, instagram } = sitio.contacto;
const hayContacto = email || telefono || instagram;
const canonica = sitio.url ? new URL(Astro.url.pathname, sitio.url).href : undefined;
// Las fotos verticales se recortan mal en las tarjetas al compartir: en ese caso, imagen apaisada general
const ogImagen = sitio.url ? new URL(ogFoto && !ogFoto.vertical ? ogFoto.grande : '/og.jpg', sitio.url).href : undefined;
const datos = [negocio(), ...jsonld];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    {ogImagen && <meta property="og:image" content={ogImagen} />}
    {ogImagen && <meta property="og:image:alt" content={ogFoto && !ogFoto.vertical ? ogFoto.alt : 'Los novios se ríen frente al mar durante una boda en la playa fotografiada por Clara Rocca'} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImagen && <meta name="twitter:image" content={ogImagen} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="saltar" href="#principal">Saltar al contenido</a>

    <!-- Textura de cera para los trazos de lápiz graso -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="cera" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="ruido" />
        <feDisplacementMap in="SourceGraphic" in2="ruido" scale="2.2" result="trazo" />
        <feComposite in="trazo" in2="ruido" operator="arithmetic" k1="0" k2="1" k3="-0.35" k4="0.12" />
      </filter>
    </svg>

    <Menu hayTrabajo={hayTrabajo} hayContacto={!!hayContacto} sobreFoto={menuSobreFoto} />

    <main id="principal">
      <slot />
    </main>

    <footer class="pie">
      <a class="pie-marca" href={ruta('/')}>{sitio.nombre}</a>
      <p class="pie-lema">Fotógrafa y modelo{sitio.contacto.ciudad && ` · ${sitio.contacto.ciudad}`}</p>
      <nav aria-label="Especialidades">
        <ul>
          {especialidades.map((e) => (
            <li><a href={ruta(`/${e.slug}/`)} aria-current={Astro.url.pathname === ruta(`/${e.slug}/`) ? 'page' : undefined}>{e.busqueda}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Más páginas">
        <ul>
          {[['/', 'Portada'], ['/portfolio/', 'Portfolio'], ['/sobre-clara/', 'Sobre Clara'], ['/contacto/', 'Contacto']].map(([p, t]) => (
            <li><a href={ruta(p)} aria-current={Astro.url.pathname === ruta(p) ? 'page' : undefined}>{t}</a></li>
          ))}
          {instagram && <li><a href={`https://www.instagram.com/${instagram}/`} rel="noopener">Instagram</a></li>}
        </ul>
      </nav>
      <p class="legal">
        <span>© {new Date().getFullYear()} {sitio.nombre}</span>
        <span>Fotografías de {sitio.nombre}, salvo las campañas en las que aparece como modelo.</span>
      </p>
    </footer>

    <script>
      // Aparición suave de los bloques marcados con .revela
      const bloques = document.querySelectorAll('.revela');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('visto'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        bloques.forEach((b) => io.observe(b));
      } else bloques.forEach((b) => b.classList.add('visto'));
    </script>
  </body>
</html>

<style>
  .pie {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.6rem;
    padding: clamp(4rem, 9vw, 7rem) var(--margen) 2rem;
    border-top: 1px solid var(--linea);
  }
  .pie-marca {
    font: 300 clamp(1.6rem, 3vw, 2.4rem)/1 var(--serif);
    letter-spacing: .32em;
    text-transform: uppercase;
    text-decoration: none;
    margin-right: -.32em;
  }
  .pie-lema { margin: -.6rem 0 1rem; font: 500 .7rem/1.4 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--grafito-suave); }
  .pie ul { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 2rem; list-style: none; margin: 0; padding: 0; }
  .pie ul a {
    font: 500 .7rem/1.6 var(--sans); letter-spacing: .18em; text-transform: uppercase;
    color: var(--grafito); text-decoration: none;
    border-bottom: 1px solid transparent; transition: border-color .3s;
  }
  .pie ul a:hover, .pie ul a[aria-current='page'] { border-bottom-color: currentColor; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 2rem;
    margin: 1.5rem 0 0; font-size: .95rem; font-style: italic; color: var(--grafito-suave);
  }
</style>
