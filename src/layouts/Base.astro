---
import { ruta } from '../lib/ruta';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/doto/latin-500.css';
import '../styles/global.css';
import { sitio } from '../config/sitio';
import { especialidades } from '../config/especialidades';
import type { Foto } from '../lib/fotos';
import Menu from '../components/Menu.astro';
import { negocio } from '../lib/negocio';

interface Props {
  titulo: string;
  descripcion: string;
  ogFoto?: Foto;
  jsonld?: object[];
  /** Si hay fotos en la web, el menú enlaza a «Trabajo» */
  hayTrabajo?: boolean;
}

const { titulo, descripcion, ogFoto, jsonld = [], hayTrabajo = false } = Astro.props;
const { email, telefono, instagram } = sitio.contacto;
const hayContacto = email || telefono || instagram;
const canonica = sitio.url ? new URL(Astro.url.pathname, sitio.url).href : undefined;
// Las fotos verticales se recortan mal en las tarjetas al compartir: en ese caso, imagen apaisada general
const ogImagen = sitio.url ? new URL(ogFoto && !ogFoto.vertical ? ogFoto.grande : '/og.jpg', sitio.url).href : undefined;
const datos = [negocio(), ...jsonld];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    {ogImagen && <meta property="og:image" content={ogImagen} />}
    {ogImagen && <meta property="og:image:alt" content={ogFoto && !ogFoto.vertical ? ogFoto.alt : 'Los novios se ríen frente al mar durante una boda en la playa fotografiada por Clara Rocca'} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImagen && <meta name="twitter:image" content={ogImagen} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e9eae6" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="saltar" href="#principal">Saltar al contenido</a>

    <!-- Textura de cera para los trazos de lápiz graso -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="cera" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="ruido" />
        <feDisplacementMap in="SourceGraphic" in2="ruido" scale="2.2" result="trazo" />
        <feComposite in="trazo" in2="ruido" operator="arithmetic" k1="0" k2="1" k3="-0.35" k4="0.12" />
      </filter>
    </svg>

    <Menu hayTrabajo={hayTrabajo} hayContacto={!!hayContacto} />

    <main id="principal">
      <slot />
    </main>

    <footer class="pie">
      <nav aria-label="Especialidades">
        <ul>
          {especialidades.map((e) => (
            <li><a href={ruta(`/${e.slug}/`)} aria-current={Astro.url.pathname === ruta(`/${e.slug}/`) ? 'page' : undefined}>{e.busqueda}</a></li>
          ))}
        </ul>
      </nav>
      <p>
        <span>© {new Date().getFullYear()} {sitio.nombre}</span>
        <span>Todas las fotografías son propiedad de {sitio.nombre}.</span>
      </p>
    </footer>
  </body>
</html>

<style>
  .pie {
    display: grid;
    gap: 1.5rem;
    padding: 2.5rem var(--margen) 1.5rem;
    font-size: .875rem;
    color: var(--grafito-suave);
  }
  .pie ul { display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; list-style: none; margin: 0; padding: 0; }
  .pie ul a { color: var(--grafito); text-underline-offset: .25em; text-decoration-color: var(--lapiz); }
  .pie ul a:not(:hover) { text-decoration: none; }
  .pie ul a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--lapiz); }
  .pie p { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem; margin: 0; }
</style>
